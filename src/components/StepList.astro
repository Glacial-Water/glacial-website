---
// Numbered step list (D56): the system's StepList, a shared code component. Each item is "Name|note".
interface Props { items: string[] }
const { items } = Astro.props;
---
<ol class="steps">
  {items.map((st, i) => { const [name, note] = st.split('|'); return (
    <li><span class="node" aria-hidden="true">{i + 1}</span><span class="label">{name}{note && <span class="note">{note}</span>}</span></li>
  ); })}
</ol>
<style>
  .steps { list-style: none; margin: 0; padding: 0; }
  .steps > li { position: relative; display: flex; gap: var(--space-3-5); padding-bottom: var(--space-4); }
  .steps > li:last-child { padding-bottom: 0; }
  .steps > li::before { content: ""; position: absolute; left: 16px; top: 36px; bottom: 0; width: 2px; background: var(--water-200); }
  .steps > li:last-child::before { display: none; }
  .node { flex: 0 0 auto; width: 34px; height: 34px; border-radius: var(--radius-pill); background: var(--water-50); border: 2px solid var(--glacier); color: var(--glacier); font-size: 15px; line-height: 30px; font-weight: 700; text-align: center; }
  .label { padding-top: 5px; font-size: 16px; line-height: 24px; font-weight: 600; }
  .note { display: block; margin-top: 2px; font-size: var(--caption-size); line-height: var(--caption-line); font-weight: 400; color: var(--ink-muted); }
</style>
