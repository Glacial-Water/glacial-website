---
// Products and prices (D120), built from PricesB.dc.html (canvas version 31). Replaces the old coming-soon stub.
// Prices are D42/D63 and appear only as the design draws them. No motion on this page. No monthly figure (D91), no Rs 20 membership (D115 e).
// [HOW YOU PAY — CONFIRM] stays a visible marker (placeholder 13) until Umer confirms it.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { whatsappUrl, phoneDisplay, phoneTel } from '../data/site';
import seal from '../assets/home/seal.png';
import bottle from '../assets/home/bottle.jpg';
import truck from '../assets/home/truck.jpg';
import rider from '../assets/home/rider.jpg';
import rosette from '../assets/home/rosette.png';
import badgeChlorine from '../assets/home/badge-chlorine-free.png';
import badge10 from '../assets/home/badge-10-step.png';
import shop from '../assets/home/shop.svg';
import logo from '../assets/glacial-logo.png';
const base = import.meta.env.BASE_URL;
const u = (n: number) => `calc(${n} * var(--u))`;
const waGlyph = '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-12.6 7.3L3 20l1.3-5.2A8.4 8.4 0 1 1 21 11.5z"/><path d="M9 9.5c0 3 2.5 5.5 5.5 5.5l1.5-1.5-2-1-1 1a4 4 0 0 1-2.5-2.5l1-1-1-2z"/></svg>';
const waPrice = 'https://wa.me/923111125124?text=' + encodeURIComponent('Hi Glacial, I have a question about your prices.');
// 10 + 1: ten paid refills in Glacial blue, the eleventh in the accent with FREE (D42, D63)
const tenPlusOne = Array.from({ length: 11 }, (_, i) => {
  const free = i === 10;
  return { label: free ? 'FREE' : 'Rs 200', body: free ? '#0a6f8f' : '#6fb6dc', neck: free ? '#0a6f8f' : '#9ccbe6', ink: free ? '#0a6f8f' : '#5b6478' };
});
const glance = [
  ['New bottle', 'Refundable deposit', 'Rs 1,300'],
  ['Exchange your bottle', 'Depends on its condition', 'Rs 650'],
  ['Walk-in refill', 'Buy 10, get 1 free', 'Rs 200'],
  ['Weekly subscription', 'Per bottle, two bottles or more', 'Rs 260'],
  ['Express delivery', 'Per bottle, 90 minutes or less*', 'Rs 280'],
];
---
<Base title="Products and prices — Glacial" description="Glacial prices: new bottle, exchange, walk-in refill, weekly subscription and express delivery across Lahore.">
  <section class="band navy">
    <div class="col">
      <h1>Certified water.<br />From Rs 200 a refill.</h1>
      <p class="lede">Pick your bottle. Pick how you get it. Every price is on this page.</p>
      <nav aria-label="Jump to a price">
        <ul class="jump">
          <li><a href="#p-walk"><span class="crop u112 mini"><img src={shop.src} alt="" width="900" height="1109" style={`margin-top:${u(-40)}`} /><span class="slot" aria-hidden="true" style={`left:82%;top:${u(21)}`}><span class="u">Rs</span><span class="v">200</span></span></span><span class="jt"><span class="jn">Walk-in</span><span class="jp">Rs 200</span></span></a></li>
          <li><a href="#p-weekly"><span class="crop u112 mini"><Image src={truck} alt="" widths={[225, 340]} sizes="115px" style={`margin-top:${u(-40)}`} /><span class="slot" aria-hidden="true" style={`left:82%;top:${u(21)}`}><span class="u">Rs</span><span class="v">260</span></span></span><span class="jt"><span class="jn">Weekly</span><span class="jp">Rs 260</span></span></a></li>
          <li><a href="#p-express"><span class="crop u112 mini"><Image src={rider} alt="" widths={[225, 340]} sizes="115px" style={`margin-top:${u(-37)}`} /><span class="slot" aria-hidden="true" style={`left:80.5%;top:${u(20)}`}><span class="u">Rs</span><span class="v">280</span></span></span><span class="jt"><span class="jn">Express</span><span class="jp">Rs 280</span></span></a></li>
        </ul>
      </nav>
    </div>
  </section>

  <section class="white sec" id="p-bottle">
    <div class="col">
      <h2>First, your bottle</h2>
      <p class="p">Pay once for your bottle. Then pay only for the water.</p>
      <div class="tiles">
        <div class="tile">
          <span class="crop u166 tile-crop">
            <Image src={bottle} alt="A new, sparkling blue Glacial 19-litre bottle" widths={[300, 450]} sizes="45vw" />
            <span class="slot" aria-hidden="true" style={`left:72%;top:${u(58)}`}><span class="u">Rs</span><span class="v small">1,300</span></span>
            <span class="pill">REFUNDABLE</span>
          </span>
          <span class="tile-text"><b>New bottle</b><small>Rs 1,300 deposit. <strong>You get it all back</strong> when you return the bottle.</small></span>
        </div>
        <div class="tile">
          <span class="crop u166 tile-crop">
            <Image src={bottle} alt="" widths={[300, 450]} sizes="45vw" />
            <svg class="ov" role="img" aria-label="An old, scuffed bottle swapped for a new, sparkling Glacial bottle" viewBox="0 0 60 130" style={`left:${u(-30)};top:${u(10)};width:${u(60)};height:${u(130)};`}>
              <defs><linearGradient id="glOldBodyP" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#a89c82" /><stop offset="0.45" stop-color="#ddd4bd" /><stop offset="1" stop-color="#9c907a" /></linearGradient></defs>
              <ellipse cx="30" cy="127" rx="24" ry="3" fill="#1a2a5b" opacity="0.18" />
              <rect x="22" y="2" width="16" height="10" rx="3" fill="#8e969e" />
              <rect x="24" y="11" width="12" height="14" fill="#cfc6ae" />
              <path d="M24 24h12c8 6 20 10 20 22v72q0 10-10 10H14q-10 0-10-10V46c0-12 12-16 20-22z" fill="url(#glOldBodyP)" />
              <rect x="4" y="62" width="52" height="6" fill="#8f846b" opacity="0.35" />
              <rect x="4" y="96" width="52" height="6" fill="#8f846b" opacity="0.35" />
              <rect x="12" y="48" width="5" height="60" rx="2.5" fill="#ffffff" opacity="0.3" />
              <path d="M44 50q-6 8 0 16" fill="none" stroke="#7d7360" stroke-width="2" stroke-linecap="round" opacity="0.7" />
              <path d="M36 76l7 3M38 82l5 2M14 108l6-3M18 112l4-2" fill="none" stroke="#7d7360" stroke-width="1.2" stroke-linecap="round" />
            </svg>
            <svg class="ov" aria-hidden="true" viewBox="0 0 32 32" style={`left:${u(14)};top:${u(62)};width:${u(32)};height:${u(32)};`}><circle cx="16" cy="16" r="15" fill="#1a2a5b" stroke="#ffffff" stroke-width="2" /><path d="M9 13h13l-3.5-3.5M23 19H10l3.5 3.5" fill="none" stroke="#ffffff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
            <span class="slot" aria-hidden="true" style={`left:72%;top:${u(58)}`}><span class="u">Rs</span><span class="v small">650</span></span>
            <span class="pill">OLD FOR NEW</span>
          </span>
          <span class="tile-text"><b>Exchange your bottle</b><small>Rs 650 a bottle. The price depends on its condition.</small></span>
        </div>
      </div>
      <div class="returning">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#0a6f8f" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5" /><path d="M7.5 12.5l3 3 6-6.5" /></svg>
        <p><strong>Already have Glacial bottles?</strong> No deposit. You pay for the water only.</p>
      </div>
    </div>
  </section>

  <section class="white sec ways" id="p-ways">
    <div class="col">
      <h2>Then, your water. Three ways.</h2>

      <article class="card" id="p-walk">
        <span class="crop u351 walk-crop">
          <img src={shop.src} alt="A Glacial Water Shop with the Glacial logo on its sign, a striped awning and bottles in the window" width="900" height="1109" />
          <span class="sign" aria-hidden="true" style={`left:${u(86)};top:${u(72)};width:${u(130)};height:${u(37)};`}><Image src={logo} alt="" widths={[80, 160]} sizes="60px" /><span>SHOP</span></span>
          <span class="slot" aria-hidden="true" style={`left:82%;top:${u(67)}`}><span class="u">Rs</span><span class="v">200</span></span>
          <Image src={rosette} alt="Free refill: buy 10, get 1 free" width={84} class="rosette" style={`left:${u(12)};top:${u(12)};width:${u(84)};height:${u(84)}`} />
        </span>
        <div class="card-body">
          <div class="name-row"><h3>Walk-in refill</h3><p class="price">Rs 200<span> /refill</span></p></div>
          <p class="lead">Buy 10 refills, get 1 free.</p>
          <p class="sub">Bring your bottle to a Glacial shop. Open 9am–9pm, every day.</p>
          <a class="go" href={`${base}delivery/#d-shops`}>Where the shops are →</a>
        </div>
      </article>

      <article class="card" id="p-weekly">
        <span class="crop u351 walk-crop">
          <Image src={truck} alt="A Glacial delivery truck loaded with water bottles" widths={[351, 702]} sizes="(min-width: 430px) 430px, 100vw" />
          <span class="slot" aria-hidden="true" style={`left:82%;top:${u(67)}`}><span class="u">Rs</span><span class="v">260</span></span>
        </span>
        <div class="card-body">
          <div class="name-row"><h3>Weekly subscription</h3><p class="price">Rs 260<span> /bottle</span></p></div>
          <p class="lead">Like clockwork. You never have to call.</p>
          <p class="sub">Same day, same time, every week. Two bottles or more.</p>
          <a class="go" href={`${base}order/`}>Start my subscription →</a>
        </div>
      </article>

      <article class="card" id="p-express">
        <span class="crop u351 rider-crop">
          <Image src={rider} alt="A Glacial rider on a scooter with a bottle in the carrier box" widths={[351, 702]} sizes="(min-width: 430px) 430px, 100vw" />
          <span class="slot" aria-hidden="true" style={`left:80.5%;top:${u(64)}`}><span class="u">Rs</span><span class="v">280</span></span>
        </span>
        <div class="card-body">
          <div class="name-row"><h3>Express delivery</h3><p class="price">Rs 280<span> /bottle</span></p></div>
          <p class="lead">Run out mid-week? A bottle at your door in 90 minutes.</p>
          <p class="sub">Order any time. At your door in 90 minutes or less<a class="star" href="#p-express-note" aria-label="See the note on delivery times">*</a></p>
          <a class="go" href={`${base}order/`}>Order express →</a>
        </div>
      </article>
    </div>
  </section>

  <section class="pale sec ten">
    <div class="col">
      <h2>Buy 10. The 11th is free.</h2>
      <ul class="bottles" role="img" aria-label="Ten refills at Rs 200 each, and an eleventh refill free">
        {tenPlusOne.map((b) => (
          <li>
            <svg width="36" height="48" viewBox="0 0 36 48" aria-hidden="true">
              <rect x="13" y="1" width="10" height="6" rx="2" fill="#1a2a5b" />
              <rect x="14.5" y="6" width="7" height="6" fill={b.neck} />
              <path d="M14 11h8c5 3 11 6 11 13v19q0 4-4 4H7q-4 0-4-4V24c0-7 6-10 11-13z" fill={b.body} />
              <rect x="3" y="27" width="30" height="3" fill="#ffffff" opacity="0.35" />
              <rect x="3" y="37" width="30" height="3" fill="#ffffff" opacity="0.35" />
              <rect x="8" y="22" width="3" height="20" rx="1.5" fill="#ffffff" opacity="0.4" />
            </svg>
            <span class="bl" style={`color:${b.ink}`}>{b.label}</span>
          </li>
        ))}
      </ul>
      <p class="strong2">10 refills × Rs 200 = Rs 2,000. The 11th: Rs 0.</p>
      <p class="muted2">At any Glacial shop. Every eleventh refill, every time.</p>
    </div>
  </section>

  <section class="white sec every">
    <div class="col every-col">
      <Image src={seal} alt="Stamp reading Quality Certified Every Month" width={196} class="seal" />
      <h2>In every price: water certified every month</h2>
      <p class="p">Rs 200 or Rs 280, it is the same pure, tested water.</p>
      <a class="link" href={`${base}quality-certs/`}>See the reports →</a>
      <ul class="badges">
        <li class="badge"><Image src={badgeChlorine} alt="" width={120} /><span class="t">Chlorine-free</span><span class="s">No chlorine taste, ever.</span></li>
        <li class="badge"><Image src={badge10} alt="" width={120} /><span class="t">10-step purification</span><span class="s">Every bottle, all ten steps.</span></li>
      </ul>
    </div>
  </section>

  <section class="pale sec glance">
    <div class="col">
      <h2>All prices at a glance</h2>
      <div class="list">
        <dl>
          {glance.map(([n, s, p], i) => <div class={`row${i === 0 ? ' first' : ''}`}><dt>{n}<span>{s}</span></dt><dd>{p}</dd></div>)}
          <div class="row"><dt>Order from the website<span>New bottle, delivery orders. Code WEB100.</span></dt><dd>Rs 100 off<br />your deposit</dd></div>
        </dl>
      </div>
      <p class="foot">Shops open 9am–9pm, every day. Delivery bookings until 7pm.</p>
      <p class="foot">How you pay: [HOW YOU PAY — CONFIRM]</p>
      <p class="foot" id="p-express-note">* Delivery times vary by location. We confirm your time when you place the order.</p>
    </div>
  </section>

  <section class="white biz">
    <div class="col">
      <div class="biz-box">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#0a6f8f" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="3" width="16" height="18" rx="1.5" /><path d="M8 7h2M14 7h2M8 11h2M14 11h2M8 15h2M14 15h2M10 21v-3h4v3" /></svg>
        <div>
          <h2>Water for your office?</h2>
          <a class="go" href={`${base}businesses/`}>See business plans →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="band navy contact">
    <div class="col">
      <h2>Start your subscription today!</h2>
      <p class="lede">Pick your bottles and send your order in one minute.</p>
      <a class="order-now" href={`${base}order/`}>Order now</a>
      <a class="wa" href={waPrice}><Fragment set:html={waGlyph} />Ask a price on WhatsApp</a>
      <a class="call" href={`tel:${phoneTel}`}>Or call {phoneDisplay}</a>
    </div>
  </section>
</Base>
<style>
  .col { width: 100%; max-width: var(--grid-phone-max); margin: 0 auto; padding: 0 var(--space-5); }
  .band { padding: 26px 0 24px; }
  .navy { background: var(--navy); color: var(--on-navy); }
  .pale { background: var(--water-50); }
  .white { background: var(--surface); }
  .navy h1, .navy h2 { color: #fff; }
  .lede { margin: 10px 0 0; color: var(--water-200); }
  .navy :focus-visible { outline-color: var(--water-200); }
  .sec { padding: 28px 0 8px; }
  .p { margin: 6px 0 0; }
  /* jump tiles in the hero (D61) */
  nav { margin-top: 20px; }
  .jump { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
  .jump a { display: flex; flex-direction: column; background: #fff; border-radius: 12px; overflow: hidden; text-decoration: none; color: var(--navy); }
  .jt { padding: 8px 6px 10px; display: flex; flex-direction: column; align-items: center; text-align: center; }
  .jn { font-size: 14px; line-height: 18px; font-weight: 700; }
  .jp { font-size: 17px; line-height: 22px; font-weight: 700; }
  .crop { position: relative; display: block; overflow: hidden; line-height: 0; container-type: inline-size; background: transparent; }
  .crop :global(img) { display: block; width: 100%; height: auto; }
  .u112 { --u: calc(100cqw / 112.33); }
  .u166 { --u: calc(100cqw / 166.5); }
  .u351 { --u: calc(100cqw / 351); }
  .mini { width: 100%; aspect-ratio: 112.33 / 85; }
  .mini .slot .u { font-size: calc(6 * var(--u)); line-height: calc(7 * var(--u)); }
  .mini .slot .v { font-size: calc(9 * var(--u)); line-height: calc(10 * var(--u)); }
  .slot { position: absolute; transform: translate(-50%, -50%); display: flex; flex-direction: column; align-items: center; justify-content: center; color: #fff; text-align: center; line-height: normal; }
  .slot .u { font-size: 11px; line-height: 13px; font-weight: 600; letter-spacing: 0.04em; }
  .slot .v { font-size: 22px; line-height: 25px; font-weight: 700; }
  .slot .v.small { font-size: 17px; line-height: 20px; }
  .ov { position: absolute; display: block; pointer-events: none; }
  .pill { position: absolute; left: 8px; bottom: 8px; padding: 4px 9px; border-radius: var(--radius-pill); background: var(--navy); color: #fff; font-size: 12px; line-height: 16px; font-weight: 700; letter-spacing: 0.08em; }
  /* bottle tiles */
  .tiles { margin-top: 14px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-3); }
  .tile { display: flex; flex-direction: column; background: var(--surface); border: 2px solid var(--water-200); border-radius: var(--radius-md); overflow: hidden; }
  .tile-crop { width: 100%; aspect-ratio: 166.5 / 140; }
  .tile-crop :global(img) { margin-top: calc(-26 * var(--u)); }
  .tile-text { display: flex; flex-direction: column; padding: 10px 12px 12px; }
  .tile-text b { font-size: 16px; line-height: 22px; }
  .tile-text small { margin-top: 2px; font-size: var(--caption-size); line-height: var(--caption-line); }
  .returning { margin-top: 12px; display: flex; align-items: center; gap: 12px; padding: 12px 14px; background: var(--water-50); border-radius: var(--radius-md); }
  .returning svg { flex: 0 0 auto; }
  .returning p { margin: 0; font-size: var(--body-small-size); line-height: var(--body-small-line); }
  /* way cards */
  .ways { padding-top: 24px; }
  .card { margin-top: 12px; background: #fff; border: 2px solid var(--water-200); border-radius: var(--radius-md); overflow: hidden; scroll-margin-top: 70px; }
  .ways h2 + .card { margin-top: 14px; }
  .walk-crop { aspect-ratio: 351 / 268; }
  .walk-crop :global(img) { margin-top: calc(-125 * var(--u)); }
  .rider-crop { aspect-ratio: 351 / 280; }
  .rider-crop :global(img) { margin-top: calc(-118 * var(--u)); }
  .sign { position: absolute; display: flex; align-items: center; justify-content: center; gap: calc(5 * var(--u)); background: #fff; border-radius: calc(6 * var(--u)); color: var(--navy); font-size: calc(15 * var(--u)); line-height: calc(18 * var(--u)); font-weight: 700; letter-spacing: 0.06em; }
  .crop .sign :global(img) { width: auto; height: calc(19 * var(--u)); margin: 0; }
  .crop :global(.rosette) { position: absolute; margin: 0; max-width: none; }
  .card-body { padding: 14px var(--space-4) 12px; }
  .name-row { display: flex; align-items: center; gap: var(--space-3); }
  .name-row h3 { flex: 1 1 auto; margin: 0; font-size: 19px; line-height: 25px; font-weight: 700; }
  .price { margin: 0; font-size: 19px; line-height: 25px; font-weight: 700; white-space: nowrap; }
  .price span { font-size: 14px; font-weight: 500; color: var(--ink-muted); }
  .lead { margin: 6px 0 0; font-size: 17px; line-height: 24px; font-weight: 700; }
  .sub { margin: 4px 0 0; font-size: var(--body-small-size); line-height: var(--body-small-line); color: var(--ink-muted); }
  .go, .link { display: inline-flex; align-items: center; min-height: var(--touch-min); font-size: 17px; line-height: 24px; font-weight: 600; text-decoration: none; }
  .go { margin-top: 4px; }
  .star { text-decoration: none; font-weight: 700; }
  /* ten plus one */
  .ten { margin-top: 20px; padding: 28px 0; }
  .bottles { margin: 18px 0 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 10px 6px; justify-items: center; }
  .bottles li { display: flex; flex-direction: column; align-items: center; gap: 4px; }
  .bl { font-size: 12px; line-height: 16px; font-weight: 700; letter-spacing: 0.04em; }
  .strong2 { margin: 16px 0 0; font-size: 17px; line-height: 24px; font-weight: 700; }
  .muted2 { margin: 4px 0 0; font-size: var(--body-small-size); line-height: var(--body-small-line); color: var(--ink-muted); }
  /* in every price */
  .every { padding: 26px 0 28px; }
  .every-col { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .every :global(.seal) { width: 196px; height: auto; display: block; }
  .every h2 { margin-top: 10px; font-size: 26px; line-height: 32px; }
  .every .p { max-width: 320px; }
  .badges { margin: 14px 0 0; padding: 0; width: 100%; list-style: none; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-3); align-items: stretch; }
  .badge { display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 14px 10px 16px; background: #fff; border: 1px solid var(--water-200); border-radius: 14px; text-align: center; }
  .badge :global(img) { display: block; width: 120px; height: 88px; object-fit: contain; }
  .badge .t { font-size: 15px; line-height: 21px; font-weight: 700; color: var(--navy); }
  .badge .s { font-size: 14px; line-height: 20px; color: var(--ink-muted); }
  /* all prices at a glance */
  .glance { padding: 28px 0 24px; }
  .glance h2 { margin-bottom: 12px; }
  .list { padding: 4px 16px; background: #fff; border-radius: var(--radius-md); }
  dl { margin: 0; }
  .row { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; padding: 12px 0; border-top: 1px solid var(--water-200); }
  .row.first { border-top: 0; }
  dt { font-size: 16px; line-height: 22px; font-weight: 600; color: var(--navy); }
  dt span { display: block; font-size: 14px; line-height: 20px; font-weight: 400; color: var(--ink-muted); }
  dd { margin: 0; font-size: 17px; line-height: 24px; font-weight: 700; color: var(--navy); text-align: right; white-space: nowrap; }
  .foot { margin: 4px 0 0; font-size: var(--caption-size); line-height: var(--caption-line); color: var(--ink-muted); }
  .list + .foot { margin-top: 12px; }
  /* business line */
  .biz { padding: 24px 0; }
  .biz-box { display: flex; align-items: center; gap: 14px; padding: 16px; border: 1px solid var(--water-200); border-radius: var(--radius-md); }
  .biz-box svg { flex: 0 0 auto; }
