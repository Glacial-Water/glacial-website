---
// Products and prices (D120, rebuilt 30 Oct from PricesB.dc.html canvas version 41 per D148 e/f, D151 a-e, D157).
// Prices are D42/D63 and appear only as the design draws them. No monthly figure (D91), no Rs 20 membership (D115 e), no portal line.
// How you pay (D127): cash on delivery first, bank transfer, pay monthly. No bank details. Hours (D34): the one line, no marker (D157 a, placeholder 30 void).
// The two bottle tiles use the same counter, pictures and price circle as Home and Order (tiles.css); 'Order these bottles →' opens /order/?new=N&ex=N.
// The three way tiles and the bottle tiles use Home's once-in-view motion (motion.css, src/lib/motion.ts); finished pose with reduced motion or no script.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import '../styles/tiles.css';
import '../styles/motion.css';
import WayMotion from '../components/WayMotion.astro';
import { phoneDisplay, phoneTel } from '../data/site';
import seal from '../assets/home/seal.png';
import bottleNew from '../assets/home/bottle-new.webp';
import truck from '../assets/home/truck.jpg';
import rider from '../assets/home/rider.jpg';
import rosette from '../assets/home/rosette.png';
import badgeChlorine from '../assets/home/badge-chlorine-free-2.webp';
import badge10 from '../assets/home/badge-10-step-2.webp';
import markPsqca from '../assets/home/mark-psqca.webp';
import sealPfa from '../assets/home/seal-pfa.webp';
import shop from '../assets/home/shop.svg';
import logo from '../assets/glacial-logo.png';
const base = import.meta.env.BASE_URL;
const u = (n: number) => `calc(${n} * var(--u))`;
const poly = (pts: number[][]) => `polygon(${pts.map(([x, y]) => `${u(x)} ${u(y)}`).join(', ')})`;
const truckClip = poly([[30,268],[30,170],[40,140],[58,112],[108,108],[110,82],[234,82],[238,96],[246,108],[258,117],[272,122],[287,124],[300,122],[308,120],[308,268]]);
const scootClip = poly([[58,280],[58,100],[84,100],[86,28],[132,28],[134,60],[166,58],[166,24],[214,24],[222,60],[232,112],[252,118],[268,140],[290,170],[306,200],[306,280]]);
const bottleClip = 'polygon(40% 0, 60% 0, 60% 14%, 96% 30%, 100% 40%, 100% 100%, 0 100%, 0 40%, 4% 30%, 40% 14%)';
const sparkle = 'M12 0C13 8 16 11 24 12C16 13 13 16 12 24C11 16 8 13 0 12C8 11 11 8 12 0Z';
const waGlyph = '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-12.6 7.3L3 20l1.3-5.2A8.4 8.4 0 1 1 21 11.5z"/><path d="M9 9.5c0 3 2.5 5.5 5.5 5.5l1.5-1.5-2-1-1 1a4 4 0 0 1-2.5-2.5l1-1-1-2z"/></svg>';
const minus = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1a2a5b" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14"/></svg>';
const plus = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1a2a5b" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>';
const waPrice = 'https://wa.me/923111125124?text=' + encodeURIComponent('Hi Glacial, I have a question about your prices.');
// 10 + 1, drawn: ten refills numbered 1 to 10, then the eleventh FREE. Counts only, no prices (D151 b).
const tenPlusOne = Array.from({ length: 11 }, (_, i) => {
  const free = i === 10;
  return { label: free ? 'FREE' : String(i + 1), body: free ? '#0a6f8f' : '#6fb6dc', neck: free ? '#0a6f8f' : '#9ccbe6', ink: free ? '#0a6f8f' : '#5b6478' };
});
const glance = [
  ['New bottle', 'Refundable deposit', 'Rs 1,300'],
  ['Exchange your bottle', 'Old for new, by its condition', 'Rs 650'],
  ['Walk-in refill', 'Every 11th refill is free', 'Rs 200'],
  ['Weekly subscription', 'Per bottle, two bottles or more', 'Rs 260'],
  ['Express delivery', 'Per bottle, 90 minutes or less*', 'Rs 280'],
];
---
<Base fabHref={waPrice} title="Products and prices — Glacial" description="Glacial prices: new bottle, exchange, walk-in refill, weekly subscription and express delivery across Lahore.">
  <section class="band navy">
    <div class="col">
      <h1><a class="cert" href={`${base}quality-certs/`}>Certified</a> water.<br />From Rs 200 a refill.</h1>
      <p class="lede">One bottle. Three ways to fill it. Every price on one page.</p>
      <nav aria-label="Jump to a price">
        <ul class="jump">
          <li><a href="#p-walk"><span class="crop u112 mini"><img src={shop.src} alt="" width="900" height="1109" style={`margin-top:${u(-40)}`} /><span class="slot" aria-hidden="true" style={`left:82%;top:${u(21)}`}><span class="u">Rs</span><span class="v">200</span></span><Image src={rosette} alt="" width={54} class="rosette" style={`left:${u(2)};top:${u(2)};width:${u(54)};height:${u(54)}`} /></span><span class="jt"><span class="jn">Walk-in</span><span class="jp">Rs 200</span><span class="free">11th FREE</span></span></a></li>
          <li><a href="#p-weekly"><span class="crop u112 mini"><Image src={truck} alt="" widths={[225, 340]} sizes="115px" style={`margin-top:${u(-40)}`} /><span class="slot" aria-hidden="true" style={`left:82%;top:${u(21)}`}><span class="u">Rs</span><span class="v">260</span></span></span><span class="jt"><span class="jn">Weekly</span><span class="jp">Rs 260</span></span></a></li>
          <li><a href="#p-express"><span class="crop u112 mini"><Image src={rider} alt="" widths={[225, 340]} sizes="115px" style={`margin-top:${u(-37)}`} /><span class="slot" aria-hidden="true" style={`left:80.5%;top:${u(20)}`}><span class="u">Rs</span><span class="v">280</span></span></span><span class="jt"><span class="jn">Express</span><span class="jp">Rs 280</span></span></a></li>
        </ul>
      </nav>
    </div>
  </section>

  <section class="white sec" id="p-bottle">
    <div class="col">
      <h2>First, your bottles</h2>
      <p class="p">Pay once for each bottle. After that, you pay for the water only.</p>
      <div class="tiles">
        <div class="tile" id="tile-new" role="group" aria-labelledby="p-new-title">
          <div class="gl-pic gl-mo">
            <Image class="gl-btl" src={bottleNew} alt="One new, sparkling blue Glacial 19-litre bottle" width={124} height={231} style={`left:${u(40)};`} />
            <span class="gl-ov shine" aria-hidden="true" style={`left:${u(40)};top:${u(36)};width:${u(52)};height:${u(97)};clip-path:${bottleClip};`}></span>
            <svg class="gl-ov spark" aria-hidden="true" viewBox="0 0 24 24" style={`left:${u(76)};top:${u(38)};width:${u(12)};height:${u(12)};--d:0.45s;`}><path d={sparkle} fill="#fff" /></svg>
            <svg class="gl-ov spark" aria-hidden="true" viewBox="0 0 24 24" style={`left:${u(30)};top:${u(72)};width:${u(10)};height:${u(10)};--d:0.6s;`}><path d={sparkle} fill="#fff" /></svg>
            <svg class="gl-ov spark" aria-hidden="true" viewBox="0 0 24 24" style={`left:${u(84)};top:${u(114)};width:${u(9)};height:${u(9)};--d:0.75s;`}><path d={sparkle} fill="#fff" /></svg>
            <span class="gl-price gl-price-sm" aria-hidden="true"><span class="u">Rs</span><span class="v">1,300</span></span>
          </div>
          <div class="gl-tile-copy">
            <span class="gl-chip">REFUNDABLE</span>
            <b class="gl-name" id="p-new-title">New bottle</b>
            <small class="gl-desc">Rs 1,300 deposit. <strong>You get it all back</strong> when you return the bottle.</small>
            <span class="stepper gl-stepper">
              <button type="button" id="decNew" aria-label="One new bottle fewer" set:html={minus}></button>
              <span class="count" id="nNew" aria-live="polite">2</span>
              <button type="button" id="incNew" aria-label="One new bottle more" set:html={plus}></button>
            </span>
          </div>
        </div>
        <div class="tile" id="tile-ex" role="group" aria-labelledby="p-ex-title">
          <div class="gl-pic gl-mo">
            <svg class="gl-ov old" role="img" aria-label="Your old bottle, swapped for one new, sparkling Glacial bottle" viewBox="0 0 470 876" style={`left:${u(3)};top:${u(36)};width:${u(52)};height:${u(97)};`}>
              <defs><linearGradient id="glOldBodyP" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#a89c82" /><stop offset="0.42" stop-color="#e2d9c3" /><stop offset="1" stop-color="#998d76" /></linearGradient></defs>
              <path d="M192 74H280V122L348 140L405 167L440 197L458 232L463 272V822L450 852L420 870H60L25 852L8 822L6 342V262L20 227L55 196L100 167L150 142L192 124Z" fill="url(#glOldBodyP)" />
              <rect x="186" y="5" width="98" height="64" rx="12" fill="#8e8778" />
              <rect x="6" y="300" width="457" height="34" fill="#8f846b" opacity="0.3" />
              <rect x="6" y="520" width="457" height="30" fill="#8f846b" opacity="0.3" />
              <rect x="6" y="740" width="457" height="30" fill="#8f846b" opacity="0.3" />
              <rect x="70" y="340" width="34" height="420" rx="17" fill="#ffffff" opacity="0.28" />
              <path d="M340 400q-40 60 0 120M300 600l50 20M310 640l35 14M90 800l40-20M110 830l30-14" fill="none" stroke="#7d7360" stroke-width="10" stroke-linecap="round" opacity="0.75" />
            </svg>
            <Image class="gl-btl newin" src={bottleNew} alt="" width={124} height={231} style={`left:${u(60)};`} />
            <span class="gl-ov shine" aria-hidden="true" style={`left:${u(60)};top:${u(36)};width:${u(52)};height:${u(97)};clip-path:${bottleClip};--d:1.05s;`}></span>
            <svg class="gl-ov swap" aria-hidden="true" viewBox="0 0 32 32" style={`left:${u(43)};top:${u(74)};width:${u(30)};height:${u(30)};`}><circle cx="16" cy="16" r="15" fill="#1a2a5b" stroke="#ffffff" stroke-width="2" /><path d="M9 13h13l-3.5-3.5M23 19H10l3.5 3.5" fill="none" stroke="#ffffff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
            <svg class="gl-ov spark" aria-hidden="true" viewBox="0 0 24 24" style={`left:${u(64)};top:${u(56)};width:${u(11)};height:${u(11)};--d:1.15s;`}><path d={sparkle} fill="#fff" /></svg>
            <svg class="gl-ov spark" aria-hidden="true" viewBox="0 0 24 24" style={`left:${u(104)};top:${u(114)};width:${u(9)};height:${u(9)};--d:1.3s;`}><path d={sparkle} fill="#fff" /></svg>
            <span class="gl-price gl-price-sm" aria-hidden="true"><span class="u">Rs</span><span class="v">650</span></span>
          </div>
          <div class="gl-tile-copy">
            <span class="gl-chip">OLD FOR NEW</span>
            <b class="gl-name" id="p-ex-title">Exchange your bottle</b>
            <small class="gl-desc">Swap your old bottle for a new one. Rs 650, by its condition.</small>
            <span class="stepper gl-stepper">
              <button type="button" id="decEx" aria-label="One exchange bottle fewer" set:html={minus}></button>
              <span class="count" id="nEx" aria-live="polite">0</span>
              <button type="button" id="incEx" aria-label="One exchange bottle more" set:html={plus}></button>
            </span>
          </div>
        </div>
      </div>

      <div class="btotal">
        <div class="brow"><span class="lbl" id="bLabel">Your bottles, 2 bottles</span><span class="total" id="bTotal" aria-live="polite">Rs 2,600</span></div>
        <p class="foot" id="bNote"></p>
        <a class="navy-btn" id="orderBottles" href={`${base}order/?new=2&ex=0`} data-order={`${base}order/`} data-fab-hide>Order these bottles →</a>
      </div>
      <div class="returning">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#0a6f8f" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5" /><path d="M7.5 12.5l3 3 6-6.5" /></svg>
        <p><strong>Already have Glacial bottles?</strong> No deposit. You pay for the water only.</p>
      </div>
    </div>
  </section>

  <section class="white sec ways" id="p-ways">
    <div class="col">
      <h2>Then, your water. Three ways.</h2>

      <article class="card" id="p-walk">
        <span class="crop u351 truck-crop gl-mo">
          <img src={shop.src} alt="A Glacial Water Shop with the Glacial logo on its sign, a striped awning and bottles in the window" width="900" height="1109" />
          <WayMotion kind="shop" />
          <span class="sign" aria-hidden="true" style={`left:${u(86)};top:${u(72)};width:${u(130)};height:${u(37)};`}><Image src={logo} alt="" widths={[80, 160]} sizes="60px" /><span>SHOP</span></span>
          <Image src={rosette} alt="Free refill offer: every 11th refill is free" width={96} class="rosette gl-pulse" style={`left:${u(10)};top:${u(10)};width:${u(96)};height:${u(96)}`} />
          <span class="gl-price gl-price-lg" aria-hidden="true"><span class="u">Rs</span><span class="v">200</span></span>
        </span>
        <div class="card-body">
          <div class="name-row"><h3>Walk-in refill</h3><p class="price">Rs 200<span> /refill</span></p></div>
          <p class="offer-big">Every 11th refill is free.</p>
          <p class="lead lead-tight">Refill 10 times. The 11th is on us.</p>
          <ol class="bottles" role="img" aria-label="Ten refills, then the eleventh refill free">
            {tenPlusOne.map((b) => (
              <li>
                <svg width="30" height="40" viewBox="0 0 36 48" aria-hidden="true">
                  <rect x="13" y="1" width="10" height="6" rx="2" fill="#1a2a5b" />
                  <rect x="14.5" y="6" width="7" height="6" fill={b.neck} />
                  <path d="M14 11h8c5 3 11 6 11 13v19q0 4-4 4H7q-4 0-4-4V24c0-7 6-10 11-13z" fill={b.body} />
                  <rect x="3" y="27" width="30" height="3" fill="#ffffff" opacity="0.35" />
                  <rect x="3" y="37" width="30" height="3" fill="#ffffff" opacity="0.35" />
                  <rect x="8" y="22" width="3" height="20" rx="1.5" fill="#ffffff" opacity="0.4" />
                </svg>
                <span class="bl" style={`color:${b.ink}`}>{b.label}</span>
              </li>
            ))}
          </ol>
          <p class="sub">Bring your bottle to any Glacial shop. It counts up, refill by refill.</p>
          <a class="go" href={`${base}delivery/#d-shops`}>Shop Locations →</a>
        </div>
      </article>

      <article class="card" id="p-weekly">
        <span class="crop u351 truck-crop gl-mo">
          <Image src={truck} alt="A Glacial delivery truck loaded with water bottles" widths={[351, 702]} sizes="(min-width: 430px) 430px, 100vw" />
          <span class="ov patch" aria-hidden="true" style={`--t:1.2s;clip-path:${truckClip};`}></span>
          <span class="ov mover truck" aria-hidden="true" style={`clip-path:${truckClip};`}><Image src={truck} alt="" widths={[351, 702]} sizes="(min-width: 430px) 430px, 100vw" /></span>
          <WayMotion kind="truck" />
          <span class="gl-price gl-price-lg" aria-hidden="true"><span class="u">Rs</span><span class="v">260</span></span>
        </span>
        <div class="card-body">
          <div class="name-row"><h3>Weekly subscription</h3><p class="price">Rs 260<span> /bottle</span></p></div>
          <p class="lead">Like clockwork. You never have to call.</p>
          <p class="sub">Same day, same time, every week. Two bottles or more.</p>
          <a class="go" href={`${base}order/`}>Start my subscription →</a>
        </div>
      </article>

      <article class="card" id="p-express">
        <span class="crop u351 rider-crop gl-mo">
          <Image src={rider} alt="A Glacial rider on a scooter with a bottle in the carrier box" widths={[351, 702]} sizes="(min-width: 430px) 430px, 100vw" />
          <span class="ov patch" aria-hidden="true" style={`--t:0.95s;clip-path:${scootClip};`}></span>
          <span class="ov mover scoot" aria-hidden="true" style={`clip-path:${scootClip};`}><Image src={rider} alt="" widths={[351, 702]} sizes="(min-width: 430px) 430px, 100vw" /></span>
          <WayMotion kind="scooter" id="prices" />
          <span class="gl-price gl-price-lg" aria-hidden="true"><span class="u">Rs</span><span class="v">280</span></span>
        </span>
        <div class="card-body">
          <div class="name-row"><h3>Express delivery</h3><p class="price">Rs 280<span> /bottle</span></p></div>
          <p class="lead">Run out mid-week? A bottle at your door in 90 minutes.</p>
          <p class="sub">Order any time. At your door in 90 minutes or less<a class="star" href="#p-express-note" aria-label="See the note on delivery times">*</a></p>
          <a class="go" href={`${base}order/`}>Order express →</a>
        </div>
      </article>
    </div>
  </section>

  <section class="pale sec every">
    <div class="col every-col">
      <Image src={seal} alt="Stamp reading Quality Certified Every Month" width={196} class="seal" />
      <h2>In every price: water certified every month</h2>
      <p class="p">Rs 200 or Rs 280, it is the same pure, tested water.</p>
      <a class="link" href={`${base}quality-certs/`}>See the reports →</a>
      <ul class="badges">
        <li class="badge"><Image src={badgeChlorine} alt="" width={120} /><span class="t">Chlorine-free</span><span class="s">No chlorine taste, ever.</span></li>
        <li class="badge"><Image src={badge10} alt="" width={120} /><span class="t">10-step purification</span><span class="s">Every bottle, all ten steps.</span></li>
        <li class="badge"><Image src={markPsqca} alt="Pakistan Standards mark of PSQCA" width={120} /><span class="t">PSQCA licensed</span><span class="s">Pakistan Standards mark</span></li>
        <li class="badge"><Image src={sealPfa} alt="Seal of the Punjab Food Authority" width={240} /><span class="t">PFA licensed</span><span class="s">Punjab Food Authority</span></li>
      </ul>
      <p class="licensed-line">Licensed by PSQCA and the Punjab Food Authority</p>
    </div>
  </section>

  <section class="white sec glance">
    <div class="col">
      <h2>All prices at a glance</h2>
      <div class="list">
        <dl>
          {glance.map(([n, s, p], i) => <div class={`row${i === 0 ? ' first' : ''}`}><dt>{n}<span>{s}</span></dt><dd>{p}</dd></div>)}
          <div class="row"><dt>Order from the website<span>New bottle, delivery orders. Code WEB100.</span></dt><dd>Rs 100 off<br />your deposit</dd></div>
        </dl>
      </div>
      <p class="foot">You pay nothing until your water arrives. Pay cash when it comes. You can also pay by bank transfer, or pay monthly.</p>
      <p class="foot">Shops open 9am–9pm, every day. Delivery bookings until 7pm.</p>
      <p class="foot" id="p-express-note">* Delivery times vary by location. We confirm your time when you place the order.</p>
    </div>
  </section>

  <section class="white biz">
    <div class="col">
      <div class="biz-box">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#0a6f8f" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="3" width="16" height="18" rx="1.5" /><path d="M8 7h2M14 7h2M8 11h2M14 11h2M8 15h2M14 15h2M10 21v-3h4v3" /></svg>
        <div>
          <h2>Water for your office?</h2>
          <p class="biz-sub">A price made for your volume. We call you back.</p>
          <a class="go" href={`${base}for-businesses/`}>See business plans →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="band navy contact">
    <div class="col">
      <h2>Start your subscription today!</h2>
      <p class="lede">Pick your bottles and send your order in one minute.</p>
      <a class="order-now" href={`${base}order/`}>Order now</a>
      <a class="wa" href={waPrice}><Fragment set:html={waGlyph} />Ask a price on WhatsApp</a>
      <a class="call" href={`tel:${phoneTel}`}>Or call {phoneDisplay}</a>
    </div>
  </section>
</Base>

<script>
  import { armMotion } from '../lib/motion';
  // D151 (a): the same two counters as Home and Order. Each tile keeps its own count; both can be active. Prices D42 (deposit Rs 1,300, exchange Rs 650).
  const $ = (id: string) => document.getElementById(id) as HTMLElement;
  const rs = (n: number) => 'Rs ' + n.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
  const bottles = (n: number) => (n === 1 ? '1 bottle' : n + ' bottles');
  let nNew = 2, nEx = 0;
  function render() {
    const count = nNew + nEx;
    const notes: string[] = [];
    if (nNew > 0) notes.push('You get the full deposit back when you return the bottle.');
    if (nNew > 0 && nEx === 0) notes.push('Have an old bottle? Swap it for Rs 650 instead.'); // D151 i: deposit and exchange side by side
    if (nEx > 0) notes.push('The exchange price depends on your bottle’s condition.');
    if (count === 0) notes.push('Add a new bottle, or swap an old one, with the + buttons.');
    $('nNew').textContent = String(nNew); $('nEx').textContent = String(nEx);
    $('tile-new').classList.toggle('on', nNew > 0); $('tile-ex').classList.toggle('on', nEx > 0);
    $('bLabel').textContent = count > 0 ? 'Your bottles, ' + bottles(count) : 'No bottles yet';
    $('bTotal').textContent = rs(1300 * nNew + 650 * nEx);
    $('bNote').textContent = notes.join(' ');
    const go = $('orderBottles') as HTMLAnchorElement;
    go.hidden = count === 0;
    go.href = (go.dataset.order || '') + '?new=' + nNew + '&ex=' + nEx; // D157 (3): Order pre-sets its counters from these
  }
  $('incNew').addEventListener('click', () => { nNew = Math.min(10, nNew + 1); render(); });
  $('decNew').addEventListener('click', () => { nNew = Math.max(0, nNew - 1); render(); });
  $('incEx').addEventListener('click', () => { nEx = Math.min(10, nEx + 1); render(); });
  $('decEx').addEventListener('click', () => { nEx = Math.max(0, nEx - 1); render(); });
  render();
  armMotion(); // D110 / D147: each picture plays once in view (src/lib/motion.ts)
</script>

<style>
  .col { width: 100%; max-width: var(--grid-phone-max); margin: 0 auto; padding: 0 var(--space-5); }
  .band { padding: 26px 0 24px; }
  .navy { background: var(--navy); color: var(--on-navy); }
  .pale { background: var(--water-50); }
  .white { background: var(--surface); }
  .navy h1, .navy h2 { color: #fff; }
