---
// For businesses (D142), built from ForBusinesses.dc.html (canvas version 35). Replaces the noindex coming-soon stub; indexable.
// Reuses Home B's pieces unchanged: seal band, badge row, fields, area-check answer line (shared rules in src/lib/areaMatch.ts, D125 b), the numbered StepList (D56).
// The quote button opens a pre-filled WhatsApp message only (one token, D71); nothing is stored or sent anywhere else, nothing writes to the CRM.
// Marker 28 [BUSINESS RATE — CONFIRM] is shown on the preview and must be filled or removed before cutover (D141 a).
// No monthly total (D91), no bank details (D127), no WEB100 on the quote (D69/D115), no client names (D139). Motion: CSS/SVG, once in view, reduce-motion shows the full rack.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import StepList from '../components/StepList.astro';
import { phoneDisplay, phoneTel } from '../data/site';
import seal from '../assets/home/seal.png';
import badgeChlorine from '../assets/home/badge-chlorine-free.png';
import badge10 from '../assets/home/badge-10-step.png';
import markPsqca from '../assets/home/mark-psqca.webp';
import sealPfa from '../assets/home/seal-pfa.webp';
const base = import.meta.env.BASE_URL;
const waGlyph = '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-12.6 7.3L3 20l1.3-5.2A8.4 8.4 0 1 1 21 11.5z"/><path d="M9 9.5c0 3 2.5 5.5 5.5 5.5l1.5-1.5-2-1-1 1a4 4 0 0 1-2.5-2.5l1-1-1-2z"/></svg>';
const WA = 'https://wa.me/923111125124';
const waAsk = WA + '?text=' + encodeURIComponent('Hi Glacial, I would like water delivery for my business.');
// Hero rack: two shelves of four bottles (36x48 drawing scaled 1.75), popping in left to right.
const xs = [26, 98, 170, 242];
const rack = Array.from({ length: 8 }, (_, i) => ({ at: `translate(${xs[i % 4]} ${i < 4 ? 7 : 101}) scale(1.75)`, d: `${(0.2 + i * 0.12).toFixed(2)}s` }));
const places = [
  ['Offices', '<rect x="4" y="3" width="16" height="18" rx="1.5"/><path d="M8 7h2M14 7h2M8 11h2M14 11h2M8 15h2M14 15h2M10 21v-3h4v3"/>'],
  ['Shops', '<path d="M3 9l1.5-5h15L21 9"/><path d="M3 9h18v1.5a3 3 0 0 1-6 0 3 3 0 0 1-6 0 3 3 0 0 1-6 0z"/><path d="M5 13v8h14v-8"/><path d="M10 21v-5h4v5"/>'],
  ['Schools', '<path d="M2 9l10-5 10 5-10 5z"/><path d="M6 11v5c0 1.5 2.7 3 6 3s6-1.5 6-3v-5"/><path d="M22 9v6"/>'],
  ['Restaurants', '<path d="M7 3v8M5 3v5a2 2 0 0 0 4 0V3M7 11v10"/><path d="M17 21V3c-2.2 0-4 2.5-4 6v4h4"/>'],
];
const pays = [
  ['Cash on delivery', 'Pay when your water arrives.', '<rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="2.5"/><path d="M6 10v4M18 10v4"/>'],
  ['Bank transfer', 'Pay from your business account.', '<path d="M3 9l9-5 9 5"/><path d="M5 10v7M10 10v7M14 10v7M19 10v7"/><path d="M3 20h18"/>'],
  ['Pay monthly', 'One payment for the whole month.', '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/><path d="M8 15l2.5 2.5L16 13"/>'],
];
const steps = [
  'Tell us how many bottles a week|Send your details below. About one minute.',
  'We fix your delivery day|We call you to confirm your delivery day and time.',
  'Full bottles in, empties out|Every week, like clockwork. You never have to call.',
];
---
<Base title="For businesses — Glacial" description="Certified, chlorine-free water for your office, shop, school or restaurant in Lahore. Full bottles every week, on time. Ask for a business quote on WhatsApp; we call you back with your price.">
  <section class="band navy">
    <div class="col">
      <h1>Your team never runs out.</h1>
      <p class="lede">Certified, chlorine-free water for your office, shop or school. Full bottles every week, on time.</p>
      <div class="rackbox gl-mo" id="rackbox">
        <svg class="gl-rack" role="img" aria-label="A water rack at work, two shelves of full Glacial bottles" viewBox="0 0 325 196" width="325" height="196">
          <rect x="4" y="4" width="6" height="190" rx="2" fill="#1a2a5b" />
          <rect x="315" y="4" width="6" height="190" rx="2" fill="#1a2a5b" />
          <rect x="4" y="92" width="317" height="6" rx="2" fill="#1a2a5b" />
          <rect x="4" y="186" width="317" height="6" rx="2" fill="#1a2a5b" />
          {rack.map((b) => (
            <g transform={b.at}>
              <g class="gl-pop" style={`--d: ${b.d};`}>
                <rect x="13" y="1" width="10" height="6" rx="2" fill="#1a2a5b" />
                <rect x="14.5" y="6" width="7" height="6" fill="#9ccbe6" />
                <path d="M14 11h8c5 3 11 6 11 13v19q0 4-4 4H7q-4 0-4-4V24c0-7 6-10 11-13z" fill="#6fb6dc" />
                <rect x="3" y="27" width="30" height="3" fill="#ffffff" opacity="0.35" />
                <rect x="3" y="37" width="30" height="3" fill="#ffffff" opacity="0.35" />
                <rect x="8" y="22" width="3" height="20" rx="1.5" fill="#ffffff" opacity="0.4" />
              </g>
            </g>
          ))}
        </svg>
        <p class="rack-cap"><span class="sq" aria-hidden="true"></span>Filled again on your day, every week</p>
      </div>
      <a class="wa" href="#b-quote"><Fragment set:html={waGlyph} />Get my business quote</a>
    </div>
  </section>

  <section class="band white">
    <div class="col">
      <h2>Water for every workplace</h2>
      <ul class="places">
        {places.map(([name, path]) => (
          <li class="place"><svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#0a6f8f" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={path} />{name}</li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band pale usp">
    <div class="col usp-col">
      <Image src={seal} alt="Stamp reading Quality Certified Every Month" width={196} class="seal" />
      <h2>Quality certified every month</h2>
      <p>Show your team the reports. We publish them every month.</p>
      <a class="link" href={`${base}quality-certs/`}>See the reports →</a>
    </div>
  </section>

  <section class="band white badges">
    <div class="col">
      <ul>
        <li class="badge"><Image src={badgeChlorine} alt="" width={120} /><span class="t">Chlorine-free</span><span class="s">No chlorine taste, ever.</span></li>
        <li class="badge"><Image src={badge10} alt="" width={120} /><span class="t">10-step purification</span><span class="s">Every bottle, all ten steps.</span></li>
        <li class="badge"><Image src={markPsqca} alt="Pakistan Standards mark of PSQCA" width={120} /><span class="t">PSQCA licensed</span><span class="s">Pakistan Standards mark</span></li>
        <li class="badge"><Image src={sealPfa} alt="Seal of the Punjab Food Authority" width={240} /><span class="t">PFA licensed</span><span class="s">Punjab Food Authority</span></li>
      </ul>
      <p class="licensed-line">Licensed by PSQCA and the Punjab Food Authority</p>
    </div>
  </section>

  <section class="band pale">
    <div class="col">
      <h2>Set it once. We do the rest.</h2>
      <div class="steps-wrap"><StepList items={steps} /></div>
      <div class="express">
        <svg width="40" height="28" viewBox="0 0 40 28" aria-hidden="true">
          <circle cx="8" cy="22" r="5" fill="none" stroke="#1a2a5b" stroke-width="2.4" />
          <circle cx="32" cy="22" r="5" fill="none" stroke="#1a2a5b" stroke-width="2.4" />
          <path d="M8 22h10l6-10h6l2 10" fill="none" stroke="#1a2a5b" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
          <rect x="2" y="6" width="12" height="11" rx="2" fill="#0a6f8f" />
          <path d="M26 12l-2-6h-4" fill="none" stroke="#1a2a5b" stroke-width="2.4" stroke-linecap="round" />
        </svg>
        <span><b>Running low before your day?</b><span class="s">Express: at your door in 90 minutes or less<a href="#b-express-note" class="star" aria-label="See the note on delivery times">*</a></span></span>
      </div>
    </div>
  </section>

  <section class="band white">
    <div class="col">
      <h2>Pay the way your business works</h2>
      <ul class="pays">
        {pays.map(([t, s, path]) => (
          <li class="pay"><span class="pay-ic"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#0a6f8f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={path} /></span><span><span class="pay-t">{t}</span><span class="pay-s">{s}</span></span></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band pale quote" id="b-quote">
    <div class="col">
      <h2>Get your business quote</h2>
      <p class="ask">How many bottles a week does your team need?</p>
      <div class="qbox">
        <div class="stepper-row">
          <span id="b-count-label" class="lbl">Bottles a week</span>
          <span class="stepper" role="group" aria-labelledby="b-count-label">
            <button type="button" id="b-less" aria-label="One bottle fewer"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1a2a5b" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14" /></svg></button>
            <span class="count" id="b-count" aria-live="polite">10</span>
            <button type="button" id="b-more" aria-label="One bottle more"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1a2a5b" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg></button>
          </span>
        </div>
        <ul class="bgrid" id="b-grid" role="img" aria-label="10 bottles a week">
          {Array.from({ length: 16 }, () => (
            <li><svg width="20" height="27" viewBox="0 0 36 48" aria-hidden="true"><rect class="cap" x="13" y="1" width="10" height="6" rx="2" /><path class="body" d="M14 11h8c5 3 11 6 11 13v19q0 4-4 4H7q-4 0-4-4V24c0-7 6-10 11-13z" /></svg></li>
          ))}
        </ul>
        <p class="more" id="b-more-note" hidden></p>
        <dl class="rows">
          <div class="row"><dt>Standard price</dt><dd>Rs 260 a bottle<br /><span id="b-weekly">Rs 2,600</span> a week</dd></div>
          <div class="row"><dt>Business rate</dt><dd>[BUSINESS RATE — CONFIRM]</dd></div>
          <div class="row"><dt>Your first bottles</dt><dd>Rs 1,300 deposit each,<br />you get it back</dd></div>
          <div class="row"><dt>Have Glacial bottles?</dt><dd>No deposit</dd></div>
        </dl>
      </div>
      <div class="fields">
        <div class="field"><label for="b-biz">Business name</label><input id="b-biz" type="text" autocomplete="organization" /></div>
        <div class="field"><label for="b-name">Your name</label><input id="b-name" type="text" autocomplete="name" /></div>
        <div class="field"><label for="b-phone">WhatsApp number</label><input id="b-phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="03XX-XXXXXXX" /></div>
        <div class="field">
          <label for="b-area">Area</label>
          <input id="b-area" type="text" autocomplete="address-level3" placeholder="For example, Johar Town" aria-describedby="b-area-answer" />
          <div class="area-live" id="b-area-answer" role="status" aria-live="polite" aria-atomic="true"></div>
        </div>
      </div>
      <p class="foot">We call you back with your price.</p>
      <a class="wa" id="b-send" href={WA}><Fragment set:html={waGlyph} />Send my quote request</a>
      <p class="foot" id="b-express-note">* Delivery times vary by location. We confirm your time when you place the order.</p>
    </div>
  </section>

  <section class="band navy contact">
    <div class="col">
      <h2>Start your business subscription today!</h2>
      <p class="sub">Fresh, certified water at work. Every week.</p>
      <a class="wa" href={waAsk}><Fragment set:html={waGlyph} />Ask about business delivery</a>
      <a class="call" href={`tel:${phoneTel}`}>Or call {phoneDisplay}</a>
    </div>
  </section>
</Base>

<script>
  import { lookupArea } from '../lib/areaMatch';
  const WA = 'https://wa.me/923111125124';
  const $ = (id: string) => document.getElementById(id) as HTMLElement;
  const val = (id: string) => (($(id) as HTMLInputElement).value || '').trim();
  // Minimum 2 (weekly subscription, D42); the picture shows up to 16, then "+ N more". No monthly total (D91).
  const MIN = 2, MAX = 200, SHOW = 16;
  let count = 10;
  const caps = Array.from(document.querySelectorAll<SVGElement>('#b-grid .cap'));
  const bodies = Array.from(document.querySelectorAll<SVGElement>('#b-grid .body'));
  const rs = (n: number) => 'Rs ' + n.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
  function links() {
    const phone = val('b-phone');
    const msg = 'Business quote: ' + (val('b-biz') || '[business]') + '\nName: ' + (val('b-name') || '[name]') + (phone ? '\nWhatsApp: ' + phone : '') +
      '\nArea: ' + (val('b-area') || '[area]') + '\nBottles a week: ' + count;
    ($('b-send') as HTMLAnchorElement).href = WA + '?text=' + encodeURIComponent(msg);
  }
  function render() {
    $('b-count').textContent = String(count);
    $('b-grid').setAttribute('aria-label', count + ' bottles a week');
    caps.forEach((c, i) => c.setAttribute('fill', i < count ? '#1a2a5b' : '#d9ecf6'));
    bodies.forEach((b, i) => b.setAttribute('fill', i < count ? '#6fb6dc' : '#eef6fb'));
    const more = $('b-more-note');
    more.hidden = count <= SHOW;
    more.textContent = '+ ' + (count - SHOW) + ' more bottles';
    $('b-weekly').textContent = rs(count * 260);
    links();
  }
  $('b-less').addEventListener('click', () => { count = Math.max(MIN, count - 1); render(); });
  $('b-more').addEventListener('click', () => { count = Math.min(MAX, count + 1); render(); });
  ['b-biz', 'b-name', 'b-phone', 'b-area'].forEach((id) => $(id).addEventListener('input', links));
  // Area answer: the same words and look as Home (D96 a, D118, D120), the one shared rule set (D125 b).
  const answer = $('b-area-answer');
  let timer: number | undefined;
  $('b-area').addEventListener('input', () => {
    window.clearTimeout(timer);
    const typed = val('b-area').replace(/\s+/g, ' ');
    if (!typed) { answer.textContent = ''; return; }
    const hit = lookupArea(typed);
    const show = () => {
      const tick = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>';
      const chat = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0a6f8f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-12.6 7.3L3 20l1.3-5.2A8.4 8.4 0 1 1 21 11.5z"></path></svg>';
      answer.textContent = '';
      const p = document.createElement('p');
      p.className = 'area-answer ' + (hit ? 'yes' : 'no');
      p.innerHTML = hit ? tick : chat;
      const t = document.createElement('span');
      t.textContent = hit ? 'Yes — we deliver to ' + hit : 'Not in ' + typed + ' yet — message us and we’ll check';
      p.appendChild(t);
      answer.appendChild(p);
    };
    if (hit) show(); else timer = window.setTimeout(show, 600);
  });
  render();
  // Motion (D110): the rack plays once when 35% is in view. Reduced motion or no IntersectionObserver: never armed, the full rack just shows.
  const rack = $('rackbox');
  if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const io = new IntersectionObserver((entries) => entries.forEach((en) => {
      if (!en.isIntersecting) return;
      rack.classList.add('is-on');
      io.unobserve(rack);
    }), { threshold: 0.35 });
    rack.classList.add('is-armed');
    io.observe(rack);
  }
</script>

<style>
  .col { width: 100%; max-width: var(--grid-phone-max); margin: 0 auto; padding: 0 var(--space-5); }
  .band { padding: 28px 0; }
  .navy { background: var(--navy); color: var(--on-navy); }
  .pale { background: var(--water-50); }
  .white { background: var(--surface); }
  .navy h1, .navy h2 { color: #fff; }
  .navy :focus-visible { outline-color: var(--water-200); }
  .lede, .sub { margin: 10px 0 0; color: var(--water-200); }
  .navy.band:first-of-type { padding: 26px 0; }
  .rackbox { margin-top: 20px; padding: 16px 14px 14px; background: #fff; border-radius: var(--radius-md); }
  .gl-rack { display: block; width: 100%; height: auto; }
  .gl-rack :global(.gl-pop) { transform-box: fill-box; transform-origin: 50% 100%; }
  .rack-cap { margin: 12px 0 0; display: flex; align-items: center; gap: 8px; font-size: 15px; line-height: 21px; font-weight: 700; color: var(--navy); }
  .sq { flex: 0 0 auto; width: 14px; height: 14px; border-radius: 4px; background: var(--glacier); }
  .wa { box-sizing: border-box; width: 100%; display: flex; align-items: center; justify-content: center; gap: 10px; min-height: 56px; margin-top: 20px; padding: 0 18px; border-radius: var(--radius-md); background: var(--whatsapp); color: var(--on-whatsapp); font-size: var(--button-whatsapp-size); line-height: var(--button-whatsapp-line); font-weight: var(--button-whatsapp-weight); text-decoration: none; }
  .wa:hover { background: var(--whatsapp-hover); color: var(--on-whatsapp); }
  .wa:active { background: var(--whatsapp-active); }
  .places { margin: 16px 0 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .place { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px; min-height: 112px; padding: 16px 10px; box-sizing: border-box; background: #fff; border: 2px solid var(--water-200); border-radius: var(--radius-md); text-align: center; font-size: 17px; line-height: 24px; font-weight: 700; color: var(--navy); }
  .usp { padding: 22px 0 18px; }
  .usp-col { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .usp :global(.seal) { width: 196px; height: auto; display: block; }
  .usp h2 { margin-top: 10px; font-size: 26px; line-height: 32px; }
  .usp p { margin: 6px 0 0; max-width: 320px; }
  .link { display: inline-flex; align-items: center; min-height: var(--touch-min); font-weight: 600; text-decoration: none; }
  .badges { padding: 28px 0 32px; }
  .badges ul { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-3); align-items: stretch; }
  .badge { display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 14px 10px 16px; box-sizing: border-box; background: #fff; border: 1px solid var(--water-200); border-radius: 14px; text-align: center; }
  .badge :global(img) { display: block; width: 120px; height: 88px; object-fit: contain; }
  .badge .t { font-size: 15px; line-height: 21px; font-weight: 700; color: var(--navy); }
  .badge .s { font-size: 14px; line-height: 20px; color: var(--ink-muted); }
  .licensed-line { margin: 16px 0 0; font-size: 17px; line-height: 24px; font-weight: 700; text-align: center; }
  .steps-wrap { margin-top: 16px; }
  .express { margin-top: 20px; display: flex; align-items: center; gap: 14px; padding: 14px 16px; background: #fff; border-radius: var(--radius-md); }
  .express svg { flex: 0 0 auto; }
  .express b { display: block; font-size: 17px; line-height: 24px; color: var(--navy); }
  .express .s { display: block; font-size: 15px; line-height: 21px; color: var(--ink-muted); }
  .star { text-decoration: none; font-weight: 700; }
  .pays { margin: 16px 0 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 12px; }
  .pay { display: flex; align-items: center; gap: 14px; padding: 14px 16px; background: #fff; border: 1px solid var(--water-200); border-radius: var(--radius-md); }
  .pay-ic { flex: 0 0 auto; width: 48px; height: 48px; border-radius: 12px; background: var(--water-50); display: flex; align-items: center; justify-content: center; }
  .pay-t { display: block; font-size: 17px; line-height: 24px; font-weight: 700; color: var(--navy); }
  .pay-s { display: block; font-size: 15px; line-height: 21px; color: var(--ink-muted); }
  .quote { padding: 28px 0 30px; scroll-margin-top: 70px; }
  .ask { margin: 8px 0 0; }
  .qbox { margin-top: 16px; padding: 16px; background: #fff; border-radius: var(--radius-md); }
  .stepper-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .lbl { font-size: 16px; line-height: 22px; font-weight: 600; color: var(--navy); }
  .stepper { display: flex; align-items: center; gap: 10px; }
  .stepper button { width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; background: #fff; border: 1px solid var(--line-strong); border-radius: var(--radius-pill); cursor: pointer; }
  .count { min-width: 30px; text-align: center; font-size: var(--h2-size); line-height: var(--h2-line); font-weight: 700; color: var(--navy); }
  .bgrid { margin: 14px 0 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(8, minmax(0, 1fr)); gap: 6px; }
  .bgrid li { display: flex; align-items: flex-end; justify-content: center; height: 40px; }
  .bgrid .cap { fill: #1a2a5b; }
  .bgrid .body { fill: #6fb6dc; }
  .more { margin: 8px 0 0; font-size: 14px; line-height: 20px; font-weight: 600; color: var(--ink-muted); }
  .more[hidden] { display: none; }
  .rows { margin: 14px 0 0; }
  .row { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; padding: 12px 0; border-top: 1px solid var(--water-200); }
  .row dt { font-size: 16px; line-height: 22px; font-weight: 600; color: var(--navy); }
  .row dd { margin: 0; font-size: 15px; line-height: 21px; font-weight: 600; color: var(--navy); text-align: right; }
  .fields { margin-top: 16px; display: flex; flex-direction: column; gap: 12px; }
