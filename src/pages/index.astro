---
// Home (variation B, D58). Built top to bottom from HomeB.dc.html (5,760px, 12 Oct 15:49) and the rulings D67-D78.
// B3 = hero, Urdu line, quality-certified band, price grid with the two interactive tiles and the offer sheet.
// B4 (done) = Lahore band, water splash, ten steps, badges, Google rating block, contact band.
// B6 (23 Oct) = round 4 from canvas version 28 (D105-D110): uniform badges, three-field area check, plain-English copy (D108),
// four-field offer sheet (D109), shop redraw (D107) and the once-only CSS/SVG motion on the price grid (D110).
// B5 (21 Oct) = the redraw from HomeB.dc.html canvas version 23 (D95-D97, D101): hero centred, larger seal, Licensed strip,
// mixed security tiles with their own steppers, no monthly total, new express headline, area wording, original shopfront.
import { Image } from 'astro:assets';
import '@fontsource/noto-naskh-arabic/arabic-600.css'; // Urdu font, self-hosted (D81 c); loaded on Home only
import Base from '../layouts/Base.astro';
import { whatsappUrl, phoneDisplay, phoneTel } from '../data/site';
import hero from '../assets/home/hero-family.jpg';
import seal from '../assets/home/seal.png';
import bottle from '../assets/home/bottle.jpg';
import truck from '../assets/home/truck.jpg';
import rider from '../assets/home/rider.jpg';
import rosette from '../assets/home/rosette.png';
import splash from '../assets/home/splash.jpg';
import badgeChlorine from '../assets/home/badge-chlorine-free.png';
import badge10 from '../assets/home/badge-10-step.png';
import markPsqca from '../assets/home/mark-psqca.webp';
import sealPfa from '../assets/home/seal-pfa.webp';
import shop from '../assets/home/shop.svg';
import logo from '../assets/glacial-logo.png';
const base = import.meta.env.BASE_URL;
const waGlyph = '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-12.6 7.3L3 20l1.3-5.2A8.4 8.4 0 1 1 21 11.5z"/><path d="M9 9.5c0 3 2.5 5.5 5.5 5.5l1.5-1.5-2-1-1 1a4 4 0 0 1-2.5-2.5l1-1-1-2z"/></svg>';
const steps = ["Underground water sourcing", "Multimedia filtration", "Activated carbon", "Ultra-filtration", "Reverse osmosis", "Mineral fortification", "Ozonisation", "Ultra-filtration|A second pass, after ozonisation.", "UV filtration", "Sterilised bottles"];
// Canvas pixel -> fluid length. Each picture frame sets --u = frame width / canvas width, so overlays stay glued to the artwork at any width.
const u = (n: number) => `calc(${n} * var(--u))`;
const poly = (pts: number[][]) => `polygon(${pts.map(([x, y]) => `${u(x)} ${u(y)}`).join(', ')})`;
const truckClip = poly([[30,268],[30,170],[40,140],[58,112],[108,108],[110,82],[234,82],[238,96],[246,108],[258,117],[272,122],[287,124],[300,122],[308,120],[308,268]]);
const scootClip = poly([[58,280],[58,100],[84,100],[86,28],[132,28],[134,60],[166,58],[166,24],[214,24],[222,60],[232,112],[252,118],[268,140],[290,170],[306,200],[306,280]]);
const bottleClip = 'polygon(32% 0, 68% 0, 68% 22%, 96% 32%, 100% 40%, 100% 100%, 0 100%, 0 40%, 4% 32%, 32% 22%)';
const sparkle = 'M12 0C13 8 16 11 24 12C16 13 13 16 12 24C11 16 8 13 0 12C8 11 11 8 12 0Z';
const star = 'M12 2.5l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.4 6.1 20.5l1.2-6.5L2.5 9.4l6.6-.9z';
---
<Base title="Glacial — pure water, delivered across Lahore">
  <figure class="hero-photo">
    <Image src={hero} alt="Three generations of a family sitting together on a sofa at home, glasses of water in their hands, a Glacial dispenser behind them" widths={[393, 550]} sizes="100vw" loading="eager" />
  </figure>

  <section class="band navy">
    <div class="col">
      <p class="urdu" dir="rtl" lang="ur">بہترین پیو ، صحتمند جیو</p>
      <h1>Certified &amp; healthy.<br />At your door, every week.</h1>
      <p class="sub">Pure water, tested every month, delivered across Lahore.</p>
      <a class="wa" href={whatsappUrl}><Fragment set:html={waGlyph} />Order on WhatsApp</a>
    </div>
  </section>

  <section class="band pale usp">
    <div class="col usp-col">
      <Image src={seal} alt="Stamp reading Quality Certified Every Month" width={196} class="seal" />
      <h2>Quality certified every month</h2>
      <p>Every month we test the water and publish the reports. Read them yourself.</p>
      <a class="link" href={`${base}quality-certs/`}>See the reports →</a>
    </div>
  </section>

  <section class="band white prices" id="prices">
    <div class="col">
      <h2>Start your subscription today!</h2>
      <p>How many bottles/week do you need?</p>

      <h3>First, your bottles</h3>
      <div class="tiles">
        <div class="tile" id="tile-new" role="group" aria-labelledby="b-new-title">
          <span class="crop u166 tile-crop gl-mo">
            <Image src={bottle} alt="A new, sparkling blue Glacial 19-litre bottle" widths={[300, 450]} sizes="45vw" />
            <span class="ov shine" aria-hidden="true" style={`left:${u(29)};top:${u(6)};width:${u(84)};height:${u(134)};clip-path:${bottleClip};`}></span>
            <svg class="ov spark" aria-hidden="true" viewBox="0 0 24 24" style={`left:${u(80)};top:${u(8)};width:${u(14)};height:${u(14)};--d:0.45s;`}><path d={sparkle} fill="#fff" /></svg>
            <svg class="ov spark" aria-hidden="true" viewBox="0 0 24 24" style={`left:${u(30)};top:${u(44)};width:${u(11)};height:${u(11)};--d:0.6s;`}><path d={sparkle} fill="#fff" /></svg>
            <svg class="ov spark" aria-hidden="true" viewBox="0 0 24 24" style={`left:${u(94)};top:${u(98)};width:${u(10)};height:${u(10)};--d:0.75s;`}><path d={sparkle} fill="#fff" /></svg>
            <span class="slot" aria-hidden="true" style={`left:72%;top:${u(58)}`}><span class="u">Rs</span><span class="v small">1,300</span></span>
            <span class="refundable">REFUNDABLE</span>
          </span>
          <span class="tile-text">
            <b id="b-new-title">New bottle</b>
            <small>Rs 1,300 deposit. <strong>You get it all back</strong> when you return the bottle.</small>
            <span class="stepper tile-stepper">
              <button type="button" id="decNew" aria-label="One new bottle fewer"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1a2a5b" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14"/></svg></button>
              <span class="count" id="newCount" aria-live="polite">2</span>
              <button type="button" id="incNew" aria-label="One new bottle more"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1a2a5b" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></button>
            </span>
          </span>
        </div>
        <div class="tile" id="tile-ex" role="group" aria-labelledby="b-ex-title">
          <span class="crop u166 tile-crop gl-mo">
            <Image src={bottle} alt="" widths={[300, 450]} sizes="45vw" />
            <span class="ov shine" aria-hidden="true" style={`left:${u(29)};top:${u(6)};width:${u(84)};height:${u(134)};clip-path:${bottleClip};--d:1.05s;`}></span>
            <svg class="ov old" role="img" aria-label="An old, scuffed bottle swapped for a new, sparkling Glacial bottle" viewBox="0 0 60 130" style={`left:${u(-30)};top:${u(10)};width:${u(60)};height:${u(130)};`}>
              <defs><linearGradient id="glOldBody" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#a89c82" /><stop offset="0.45" stop-color="#ddd4bd" /><stop offset="1" stop-color="#9c907a" /></linearGradient></defs>
              <ellipse cx="30" cy="127" rx="24" ry="3" fill="#1a2a5b" opacity="0.18" />
              <rect x="22" y="2" width="16" height="10" rx="3" fill="#8e969e" />
              <rect x="24" y="11" width="12" height="14" fill="#cfc6ae" />
              <path d="M24 24h12c8 6 20 10 20 22v72q0 10-10 10H14q-10 0-10-10V46c0-12 12-16 20-22z" fill="url(#glOldBody)" />
              <rect x="4" y="62" width="52" height="6" fill="#8f846b" opacity="0.35" />
              <rect x="4" y="96" width="52" height="6" fill="#8f846b" opacity="0.35" />
              <rect x="12" y="48" width="5" height="60" rx="2.5" fill="#ffffff" opacity="0.3" />
              <path d="M44 50q-6 8 0 16" fill="none" stroke="#7d7360" stroke-width="2" stroke-linecap="round" opacity="0.7" />
              <path d="M36 76l7 3M38 82l5 2M14 108l6-3M18 112l4-2" fill="none" stroke="#7d7360" stroke-width="1.2" stroke-linecap="round" />
            </svg>
            <svg class="ov swap" aria-hidden="true" viewBox="0 0 32 32" style={`left:${u(14)};top:${u(62)};width:${u(32)};height:${u(32)};`}><circle cx="16" cy="16" r="15" fill="#1a2a5b" stroke="#ffffff" stroke-width="2" /><path d="M9 13h13l-3.5-3.5M23 19H10l3.5 3.5" fill="none" stroke="#ffffff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
            <svg class="ov spark" aria-hidden="true" viewBox="0 0 24 24" style={`left:${u(80)};top:${u(8)};width:${u(14)};height:${u(14)};--d:1.15s;`}><path d={sparkle} fill="#fff" /></svg>
            <svg class="ov spark" aria-hidden="true" viewBox="0 0 24 24" style={`left:${u(98)};top:${u(100)};width:${u(10)};height:${u(10)};--d:1.3s;`}><path d={sparkle} fill="#fff" /></svg>
            <span class="slot" aria-hidden="true" style={`left:72%;top:${u(58)}`}><span class="u">Rs</span><span class="v small">650</span></span>
            <span class="refundable">OLD FOR NEW</span>
          </span>
          <span class="tile-text">
            <b id="b-ex-title">Exchange your bottle</b>
            <small>Rs 650 a bottle. The price depends on its condition.</small>
            <span class="stepper tile-stepper">
              <button type="button" id="decEx" aria-label="One exchange bottle fewer"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1a2a5b" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14"/></svg></button>
              <span class="count" id="exCount" aria-live="polite">0</span>
              <button type="button" id="incEx" aria-label="One exchange bottle more"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1a2a5b" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></button>
            </span>
          </span>
        </div>
      </div>

      <div class="plan" id="plan">
        <dl class="plan-lines">
          <div id="rowNew"><dt id="newLine"></dt><dd id="newTotal"></dd></div>
          <div id="rowEx"><dt id="exLine"></dt><dd id="exTotal"></dd></div>
        </dl>
        <div class="total-row"><span class="lbl" id="secLabel"></span><span class="total" id="secTotal"></span></div>
        <p class="foot" id="secFoot"></p>
        <button type="button" class="navy-btn" id="openOffer">See my total and my offer →</button>
      </div>

      <h3 class="three">Then choose how you get your water</h3>

      <div class="card outline">
        <span class="crop u351 truck-crop gl-mo">
          <img src={shop.src} alt="A Glacial Water Shop with the Glacial logo on its sign, a striped awning and bottles in the window" width="900" height="1109" />
          <span class="sign" aria-hidden="true" style={`left:${u(86)};top:${u(72)};width:${u(130)};height:${u(37)};`}><Image src={logo} alt="" widths={[80, 160]} sizes="60px" /><span>SHOP</span></span>
          <span class="slot" aria-hidden="true" style={`left:82%;top:${u(67)}`}><span class="u">Rs</span><span class="v">200</span></span>
          <Image src={rosette} alt="Free refill: buy 10, get 1 free" width={84} class="rosette" style={`left:${u(12)};top:${u(12)};width:${u(84)};height:${u(84)}`} />
        </span>
        <div class="card-body">
          <div class="name-row"><h4>Walk-in refill</h4><p class="price">Rs 200</p></div>
          <p class="strong">Buy 10 refills, get 1 free.</p>
          <p class="small muted">Bring your bottle to a Glacial shop. Open 9am–9pm, every day.</p>
          <a class="link small-link" href={`${base}delivery/`}>Where the shops are →</a>
        </div>
      </div>

      <div class="card outline">
        <span class="crop u351 truck-crop gl-mo">
          <Image src={truck} alt="A Glacial delivery truck loaded with water bottles" widths={[351, 702]} sizes="(min-width: 430px) 430px, 100vw" />
          <span class="ov patch" aria-hidden="true" style={`--t:1.2s;clip-path:${truckClip};`}></span>
          <span class="ov mover truck" aria-hidden="true" style={`clip-path:${truckClip};`}><Image src={truck} alt="" widths={[351, 702]} sizes="(min-width: 430px) 430px, 100vw" /></span>
          <svg class="ov lines lines-l" aria-hidden="true" viewBox="0 0 40 70" style={`left:${u(312)};top:${u(150)};width:${u(40)};height:${u(70)};`}><path d="M4 6h30M12 34h26M6 62h28" fill="none" stroke="#fff" stroke-width="4" stroke-linecap="round" /></svg>
          <span class="slot" aria-hidden="true" style={`left:82%;top:${u(67)}`}><span class="u">Rs</span><span class="v">260</span></span>
        </span>
        <div class="card-body">
          <div class="name-row"><h4>Weekly subscription</h4><p class="price">Rs 260</p></div>
          <p class="strong">Like clockwork. You never have to call.</p>
          <p class="small muted">Same day, same time, every week. Two bottles or more.</p>
          <div class="live">
            <div class="live-row"><span class="lbl s" id="weeklyLabel">Your subscription, 2 bottles</span><span class="live-total" id="weeklyTotal" aria-live="polite">Rs 520</span></div>
            <p class="foot" id="weeklyNote">Delivered the same day each week.</p>
          </div>
        </div>
      </div>

      <div class="card outline">
        <span class="crop u351 rider-crop gl-mo">
          <Image src={rider} alt="A Glacial rider on a scooter with a bottle in the carrier box" widths={[351, 702]} sizes="(min-width: 430px) 430px, 100vw" />
          <span class="ov patch" aria-hidden="true" style={`--t:0.95s;clip-path:${scootClip};`}></span>
          <span class="ov mover scoot" aria-hidden="true" style={`clip-path:${scootClip};`}><Image src={rider} alt="" widths={[351, 702]} sizes="(min-width: 430px) 430px, 100vw" /></span>
          <svg class="ov lines lines-r" aria-hidden="true" viewBox="0 0 40 70" style={`left:${u(14)};top:${u(170)};width:${u(40)};height:${u(70)};`}><path d="M6 6h30M2 34h26M8 62h28" fill="none" stroke="#fff" stroke-width="4" stroke-linecap="round" /></svg>
          <span class="slot" aria-hidden="true" style={`left:80.5%;top:${u(64)}`}><span class="u">Rs</span><span class="v">280</span></span>
        </span>
        <div class="card-body">
          <div class="name-row"><h4>Express delivery</h4><p class="price">Rs 280</p></div>
          <p class="strong">Run out mid-week? A bottle at your door in 90 minutes.</p>
          <p class="small muted">Order any time. At your door in 90 minutes or less<a href="#express-note" class="star" aria-label="See the note on delivery times">*</a></p>
        </div>
      </div>

      <p class="foot" id="express-note">* Delivery times vary by location. We confirm your time when you place the order.</p>
      <a class="link" href={`${base}prices/`}>All prices →</a>
    </div>
  </section>

  <figure class="splash">
    <Image src={splash} alt="" width={551} loading="lazy" />
  </figure>
  <section class="band pale lahore">
    <div class="col">
      <h2>We deliver across most of Lahore.</h2>
      <p>Tell us your area. We'll reply on WhatsApp.</p>
      <div class="fields">
        <div class="field"><label for="a-name">Name</label><input id="a-name" type="text" autocomplete="name" /></div>
        <div class="field"><label for="a-phone">Phone</label><input id="a-phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="03XX-XXXXXXX" /></div>
        <div class="field"><label for="a-area">Area</label><input id="a-area" type="text" autocomplete="address-level3" placeholder="For example, Johar Town" aria-describedby="areaAnswer" /></div>
        <div class="area-live" id="areaAnswer" role="status" aria-live="polite" aria-atomic="true"></div>
      </div>
      <p class="foot">We'll message you about delivery in your area.</p>
      <a class="wa" id="areaHref" href={whatsappUrl}><Fragment set:html={waGlyph} />Check my area</a>
    </div>
  </section>

  <section class="band navy steps-head">
    <div class="col">
      <h2>Ten steps. From the ground to your glass.</h2>
      <p class="sub">Chlorine-free, every bottle, every week.</p>
    </div>
  </section>
  <section class="band white steps-body">
    <div class="col">
      <ol class="steps">
        {steps.map((st, i) => { const [name, note] = st.split('|'); return (
          <li><span class="node" aria-hidden="true">{i + 1}</span><span class="label">{name}{note && <span class="note">{note}</span>}</span></li>
        ); })}
      </ol>
    </div>
  </section>

  <section class="band white badges">
    <div class="col">
      <ul>
        <li class="badge"><Image src={badgeChlorine} alt="" width={120} /><span class="t">Chlorine-free</span><span class="s">No chlorine taste, ever.</span></li>
        <li class="badge"><Image src={badge10} alt="" width={120} /><span class="t">10-step purification</span><span class="s">Every bottle, all ten steps.</span></li>
        <li class="badge"><Image src={markPsqca} alt="Pakistan Standards mark of PSQCA" width={120} /><span class="t">PSQCA licensed</span><span class="s">Pakistan Standards mark</span></li>
        <li class="badge"><Image src={sealPfa} alt="Seal of the Punjab Food Authority" width={120} /><span class="t">PFA licensed</span><span class="s">Punjab Food Authority</span></li>
      </ul>
      <p class="licensed-line">Licensed by PSQCA and the Punjab Food Authority</p>
    </div>
  </section>

  <section class="band pale reviews">
    <div class="col">
      <h2>What our customers say</h2>
      <div class="rating">
        <span class="glogo" aria-hidden="true">GOOGLE LOGO</span>
        <div class="rating-text"><p class="r-big">[RATING] out of 5</p><p class="r-sub">on Google, from [COUNT] reviews</p></div>
        <span class="stars" aria-hidden="true">
          {[1, 2, 3, 4, 5].map((n) => <svg width="18" height="18" viewBox="0 0 24 24" fill={n < 5 ? '#1a2a5b' : '#b9dcee'}><path d={star} /></svg>)}
        </span>
      </div>
      <p class="foot">[GOOGLE LOGO — drop in the official brand asset at build. Stars shown are a stand-in until [RATING] arrives.]</p>
      {[1, 2, 3].map((n) => (
        <blockquote><p>[REVIEW {n} — REAL WORDS FROM THE GOOGLE PROFILE]</p><footer>[FIRST NAME], Lahore</footer></blockquote>
      ))}
      <p class="foot">[LINK TO THE GOOGLE PROFILE — CONFIRM] — "See all reviews on Google →"</p>
    </div>
  </section>

  <section class="band navy contact">
    <div class="col">
      <h2>Order your first bottle on WhatsApp</h2>
      <p class="sub">Send your address. We'll confirm your delivery time the same day.</p>
      <a class="wa" href={whatsappUrl}><Fragment set:html={waGlyph} />Message on WhatsApp</a>
      <a class="call" href={`tel:${phoneTel}`}>{phoneDisplay}</a>
    </div>
  </section>

  <dialog id="offer-sheet" class="sheet" aria-labelledby="offer-title">
    <div class="handle" aria-hidden="true"></div>
    <h2 id="offer-title">Here's your order</h2>
    <p class="foot top">You pay nothing on this page.</p>
    <dl>
      <div id="oRowNew"><dt id="oNewLine"></dt><dd id="oNewTotal"></dd></div>
      <div id="oRowEx"><dt id="oExLine"></dt><dd id="oExTotal"></dd></div>
      <div><dt>Bottles to start</dt><dd><s id="oSecTotal"></s> <b id="oSecOffer"></b></dd></div>
      <div><dt id="oWeeklyLabel"></dt><dd id="oWeekly"></dd></div>
    </dl>
    <p class="offer">Order from the website: Rs 100 off your deposit.</p>
    <p class="foot">Your code WEB100 is added to the message. <span id="oFoot"></span></p>
    <div class="fields sheet-fields">
      <div class="field"><label for="o-name">Name</label><input id="o-name" type="text" autocomplete="name" /></div>
      <div class="field"><label for="o-wa">WhatsApp number</label><input id="o-wa" type="tel" inputmode="tel" autocomplete="tel" placeholder="03XX-XXXXXXX" /></div>
      <div class="field"><label for="o-addr">Delivery address</label><input id="o-addr" type="text" autocomplete="street-address" /></div>
      <div class="field"><label for="o-mail">Email <span class="opt">(optional)</span></label><input id="o-mail" type="email" autocomplete="email" /></div>
    </div>
    <p class="foot">We'll confirm your order on WhatsApp.</p>
    <a class="wa" id="oHref" href={whatsappUrl}><Fragment set:html={waGlyph} />Claim my offer on WhatsApp</a>
    <button type="button" class="cancel" data-close-offer>Not yet — keep looking</button>
  </dialog>
</Base>

<script>
  import areaData from '../data/areas.json';
  // Prices: 00-INDEX D42/D63 (new bottle Rs 1,300 deposit; exchange Rs 650; weekly Rs 260 a bottle). Offer: D69/D73 (WEB100, Rs 100 off the deposit).
  // Mixed security (D95 e): each tile has its own stepper, both can be active, totals add, weekly count is the sum. No monthly total (D91).
  const WA = 'https://wa.me/923111125124';
  const $ = (id: string) => document.getElementById(id) as HTMLElement;
  const rs = (n: number) => 'Rs ' + n.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
  const bottles = (n: number) => (n === 1 ? '1 bottle' : n + ' bottles');
  let nNew = 2, nEx = 0;
  const sheet = $('offer-sheet') as HTMLDialogElement;
  function render() {
    const count = nNew + nEx, hasNew = nNew > 0, hasEx = nEx > 0;
    const newSum = 1300 * nNew, exSum = 650 * nEx, sec = newSum + exSum, weekly = 260 * count;
    const feet: string[] = [];
    if (hasNew) feet.push('You get the full deposit back when you return the bottle.');
    if (hasEx) feet.push('The exchange price depends on your bottle’s condition.');
    const foot = feet.join(' ');
    const newLine = 'New bottle deposit × ' + nNew, exLine = 'Exchange × ' + nEx;
    $('newCount').textContent = String(nNew); $('exCount').textContent = String(nEx);
    $('tile-new').classList.toggle('on', hasNew); $('tile-ex').classList.toggle('on', hasEx);
    ($('plan') as HTMLElement).hidden = count === 0;
    ($('rowNew') as HTMLElement).hidden = !hasNew; ($('rowEx') as HTMLElement).hidden = !hasEx;
    ($('oRowNew') as HTMLElement).hidden = !hasNew; ($('oRowEx') as HTMLElement).hidden = !hasEx;
    $('newLine').textContent = newLine; $('newTotal').textContent = rs(newSum);
    $('exLine').textContent = exLine; $('exTotal').textContent = rs(exSum);
    $('secLabel').textContent = 'Bottles to start, ' + bottles(count); $('secTotal').textContent = rs(sec); $('secFoot').textContent = foot;
    $('weeklyTotal').textContent = rs(weekly);
    $('weeklyLabel').textContent = 'Your subscription, ' + bottles(count);
    $('weeklyNote').textContent = count < 2 ? 'Weekly delivery starts at two bottles.' : 'Delivered the same day each week.';
    $('oNewLine').textContent = newLine; $('oNewTotal').textContent = rs(newSum);
    $('oExLine').textContent = exLine; $('oExTotal').textContent = rs(exSum);
    $('oSecTotal').textContent = rs(sec); $('oSecOffer').textContent = rs(Math.max(0, sec - 100));
    $('oWeeklyLabel').textContent = 'Weekly subscription, ' + bottles(count); $('oWeekly').textContent = rs(weekly) + ' a week';
    $('oFoot').textContent = foot;
    lines = ['Hi Glacial, I’d like to start my subscription.'];
    if (hasNew) lines.push('New bottle (refundable deposit) × ' + nNew + ' — ' + rs(newSum));
    if (hasEx) lines.push('Exchange my bottle × ' + nEx + ' — ' + rs(exSum) + ' (by condition)');
    lines.push('Weekly subscription, ' + bottles(count) + ' — ' + rs(weekly) + ' a week');
    lines.push('Website offer code: WEB100 (Rs 100 off the deposit)');
    links();
  }
  // D109: the sheet's four fields travel in the pre-filled WhatsApp message (nothing is stored or sent anywhere else).
  // D106: the area check opens WhatsApp with "Area check: [area] — [name]" and the phone on the next line.
  let lines: string[] = [];
  const val = (id: string) => ((document.getElementById(id) as HTMLInputElement | null)?.value || '').trim();
  function links() {
    const m = lines.slice();
    m.push('Name: ' + val('o-name'), 'WhatsApp number: ' + val('o-wa'), 'Delivery address: ' + val('o-addr'));
    if (val('o-mail')) m.push('Email: ' + val('o-mail'));
    ($('oHref') as HTMLAnchorElement).href = WA + '?text=' + encodeURIComponent(m.join('\n'));
    const phone = val('a-phone');
    const area = 'Area check: ' + (val('a-area') || '[area]') + ' — ' + (val('a-name') || '[name]') + (phone ? '\nPhone: ' + phone : '');
    ($('areaHref') as HTMLAnchorElement).href = WA + '?text=' + encodeURIComponent(area);
  }
  // D118: the area check answers as the visitor types. The list is areas.json (141 areas, 30 sub-areas), read in the browser; no request to any server (D22).
  // Matching (D118 b): case-insensitive on a name or an alias; plain "DHA" counts as served (parent of the DHA Phase areas); a sub-area alone ("Block R")
  // does not; "Johar Town Block R" is the parent Johar Town. "Punjab Society" is served. "Park View Society" = Park View City.
  // Bahria Town, Bahria Orchard and Nasheman Iqbal stay distinct: only exact names match, no prefix guessing beyond the Phase rule.
  const norm = (t: string) => t.toLowerCase().replace(/&/g, ' and ').replace(/[^a-z0-9]+/g, ' ').trim();
  const served = new Map<string, string>();
  const subOf = new Map<string, string[]>();
  for (const a of areaData.areas) {
    served.set(norm(a.name), a.name);
    a.aliases.forEach((x) => served.set(norm(x), a.name));
    const m = /^(.*) phase \d+$/i.exec(a.name);
    if (m && !served.has(norm(m[1]))) served.set(norm(m[1]), m[1]);
    if (a.subAreas.length) subOf.set(norm(a.name), a.subAreas.map(norm));
  }
  served.set('park view society', 'Park View City'); // D118 b: Register S2 absorbs Park View Society into Park View City
  function lookup(typed: string): string | null {
    const q = norm(typed);
    if (!q) return null;
    const hit = served.get(q);
    if (hit) return hit;
    for (const [parent, subs] of subOf) {
      if (q.startsWith(parent + ' ')) {
        const rest = q.slice(parent.length + 1).replace(/^block /, '');
        if (subs.some((x) => x === rest || x === 'block ' + rest)) return served.get(parent) || null;
      }
    }
    return null;
  }
  const answer = $('areaAnswer');
  let answerTimer: number | undefined;
  function areaAnswer() {
    window.clearTimeout(answerTimer);
    const typed = val('a-area').replace(/\s+/g, ' ');
    if (!typed) { answer.textContent = ''; return; }
    const hit = lookup(typed);
    const show = () => {
      const tick = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>';
      const chat = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0a6f8f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-12.6 7.3L3 20l1.3-5.2A8.4 8.4 0 1 1 21 11.5z"></path></svg>';
      answer.textContent = '';
      const p = document.createElement('p');
      p.className = 'area-answer ' + (hit ? 'yes' : 'no');
      p.innerHTML = hit ? tick : chat;
      const t = document.createElement('span');
      t.textContent = hit ? 'Yes — we deliver to ' + hit : 'Not in ' + typed + ' yet — message us and we\u2019ll check';
      p.appendChild(t);
      answer.appendChild(p);
    };
    if (hit) show(); else answerTimer = window.setTimeout(show, 600); // wait for a pause before saying "not yet" mid-word
  }
  $('a-area').addEventListener('input', areaAnswer);
  ['o-name', 'o-wa', 'o-addr', 'o-mail', 'a-name', 'a-phone', 'a-area'].forEach((id) => $(id).addEventListener('input', links));
  $('incNew').addEventListener('click', () => { nNew = Math.min(10, nNew + 1); render(); });
  $('decNew').addEventListener('click', () => { nNew = Math.max(0, nNew - 1); render(); });
  $('incEx').addEventListener('click', () => { nEx = Math.min(10, nEx + 1); render(); });
  $('decEx').addEventListener('click', () => { nEx = Math.max(0, nEx - 1); render(); });
  let opener: HTMLElement | null = null;
  $('openOffer').addEventListener('click', (e) => { opener = e.currentTarget as HTMLElement; sheet.showModal(); });
  sheet.addEventListener('click', (e) => { const t = e.target as HTMLElement; if (t === sheet || t.closest('[data-close-offer]')) sheet.close(); });
  sheet.addEventListener('close', () => opener?.focus());
  render();
  // D110: each picture on the price grid plays once, when 35% of it scrolls into view. With reduced motion, or without
  // IntersectionObserver, nothing is armed and every picture simply shows its finished pose.
  const mo = Array.from(document.querySelectorAll<HTMLElement>('.gl-mo'));
  if (mo.length && 'IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const io = new IntersectionObserver((entries) => entries.forEach((en) => {
      if (!en.isIntersecting) return;
      (en.target as HTMLElement).classList.add('is-on');
      io.unobserve(en.target);
    }), { threshold: 0.35 });
    mo.forEach((el) => { el.classList.add('is-armed'); io.observe(el); });
  }
</script>

