---
import Base from '../layouts/Base.astro';
import { getImage } from 'astro:assets';

// D23: drop a file named YYYY-MM.jpg (or .png) into /reports and it appears here, newest first.
const files = import.meta.glob('/reports/*.{jpg,jpeg,png}', { eager: true, import: 'default' }) as Record<string, ImageMetadata>;
const months = ['January','February','March','April','May','June','July','August','September','October','November','December'];

const items = [];
for (const [path, img] of Object.entries(files)) {
  const m = path.match(/\/(\d{4})-(\d{2})\.(?:jpe?g|png)$/i);
  if (!m) continue; // ignore files not named YYYY-MM
  const year = Number(m[1]); const month = Number(m[2]);
  if (month < 1 || month > 12) continue;
  const thumbWebp = await getImage({ src: img, width: 360, format: 'webp', quality: 60 });
  const thumbJpg = await getImage({ src: img, width: 360, format: 'jpeg', quality: 60 });
  const full = await getImage({ src: img, width: 1600, format: 'jpeg', quality: 80 });
  items.push({ year, month, label: `${months[month - 1]} ${year}`, thumbWebp, thumbJpg, full });
}
items.sort((a, b) => b.year - a.year || b.month - a.month);
const years = [...new Set(items.map((i) => i.year))];
---
<Base title="Quality Certs — Glacial">
  <div class="hero"><div class="wrap"><h1>Quality Certs</h1></div></div>
  {years.length === 0 && <div class="wrap"><p>No reports yet.</p></div>}
  {years.map((y, idx) => (
    <section class:list={['year', { alt: idx % 2 === 1 }]} aria-labelledby={`y${y}`}>
      <div class="wrap">
        <h2 id={`y${y}`}>{y}</h2>
        <ul class="grid">
          {items.filter((i) => i.year === y).map((i) => (
            <li>
              <a class="tile" href={i.full.src} aria-label={`${i.label} report — open full scan`}>
                <picture>
                  <source type="image/webp" srcset={i.thumbWebp.src} />
                  <img src={i.thumbJpg.src} alt={`${i.label} report`} width="360" height="480" loading="lazy" decoding="async" />
                </picture>
                <span class="cap">{i.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}
</Base>
<style>
  .hero { background: var(--navy); color: var(--on-navy); padding: var(--space-8) 0; }
  .year { padding: var(--space-8) 0; }
  .year.alt { background: var(--water-50); }
  .year h2 { margin-bottom: var(--space-4); }
  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--grid-gutter); }
  @media (min-width: 768px) { .grid { grid-template-columns: repeat(3, 1fr); } .year { padding: var(--space-12) 0; } }
  .tile { display: block; text-decoration: none; color: var(--ink); min-height: var(--touch-min); }
  .tile img { display: block; width: 100%; aspect-ratio: 3 / 4; object-fit: cover; border-radius: var(--radius-sm); border: var(--border-width) solid var(--water-200); background: var(--surface); }
  .cap { display: block; margin-top: var(--space-2); font-size: var(--body-small-size); line-height: var(--body-small-line); font-weight: var(--body-small-weight); }
</style>
