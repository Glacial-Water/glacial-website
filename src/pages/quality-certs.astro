---
import Base from '../layouts/Base.astro';
import { getImage } from 'astro:assets';

// D23: drop a file named YYYY-MM.jpg (or .png) into /reports and it appears here, newest first.
const files = import.meta.glob('/reports/*.{jpg,jpeg,png}', { eager: true, import: 'default' }) as Record<string, ImageMetadata>;
const months = ['January','February','March','April','May','June','July','August','September','October','November','December'];

const items = [];
for (const [path, img] of Object.entries(files)) {
  const m = path.match(/\/(\d{4})-(\d{2})\.(?:jpe?g|png)$/i);
  if (!m) continue; // ignore files not named YYYY-MM
  const year = Number(m[1]); const month = Number(m[2]);
  if (month < 1 || month > 12) continue;
  const thumbWebp = await getImage({ src: img, width: 360, format: 'webp', quality: 60 });
  const thumbJpg = await getImage({ src: img, width: 360, format: 'jpeg', quality: 60 });
  const full = await getImage({ src: img, width: 1600, format: 'jpeg', quality: 80 });
  items.push({ year, month, label: `${months[month - 1]} ${year}`, thumbWebp, thumbJpg, full });
}
items.sort((a, b) => b.year - a.year || b.month - a.month);
const years = [...new Set(items.map((i) => i.year))];
const recentYears = years.slice(0, 3);
const earlierYears = years.slice(3);
---
<Base title="Quality Certs — Glacial">
  <div class="hero">
    <div class="wrap">
      <h1>Quality Certs</h1>
      <p class="lede">Our published reports, newest first. Open any one and read it yourself.</p>
      {items.length === 0 && <p class="marker">[HOW MANY REPORTS, AND WHICH MONTHS? — no report files loaded yet]</p>}
    </div>
  </div>
  {years.length > 1 && (
    <nav class="yearbar" aria-label="Jump to a year">
      <div class="wrap bar">
        {recentYears.map((y, idx) => <a href={`#y${y}`} aria-current={idx === 0 ? 'true' : undefined}>{y}</a>)}
        {earlierYears.length > 0 && (
          <details class="earlier">
            <summary>Earlier years</summary>
            <div class="menu">
              {earlierYears.map((y) => <a href={`#y${y}`}>{y}</a>)}
            </div>
          </details>
        )}
      </div>
    </nav>
  )}
  {years.map((y, idx) => (
    <section id={`y${y}`} class:list={['year', { alt: idx % 2 === 1 }]} aria-labelledby={`h${y}`}>
      <div class="wrap">
        <h2 id={`h${y}`}>{y}</h2>
        {idx === 0 && <p class="note">Newest published report: {items[0].label}.</p>}
        <ul class="grid">
          {items.filter((i) => i.year === y).map((i) => (
            <li>
              <a class="tile" href={i.full.src} aria-label={`${i.label} report — open full scan`}>
                <picture>
                  <source type="image/webp" srcset={i.thumbWebp.src} />
                  <img src={i.thumbJpg.src} alt={`${i.label} report`} width="360" height="480" loading="lazy" decoding="async" />
                </picture>
                <span class="cap">{i.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}
</Base>
<style>
  .hero { background: var(--navy); color: var(--on-navy); padding: var(--space-8) 0; }
  .lede { margin: 10px 0 0; color: var(--water-200); }
  .marker { margin: var(--space-2) 0 0; font-size: var(--caption-size); line-height: var(--caption-line); color: var(--water-200); }
  .yearbar { position: sticky; top: var(--header-height); z-index: 2; background: var(--water-50); border-bottom: var(--border-width) solid var(--water-200); padding: var(--space-3) 0; }
  .bar { display: flex; gap: var(--space-2); flex-wrap: wrap; }
  .bar a { flex: 0 0 auto; display: inline-flex; align-items: center; height: var(--chip-height); padding: 0 var(--space-4); border: var(--border-width) solid var(--glacier); border-radius: var(--radius-pill); background: var(--surface); color: var(--navy); font-size: var(--button-small-size); line-height: var(--button-small-line); font-weight: var(--button-small-weight); text-decoration: none; }
  .earlier { position: relative; flex: 0 0 auto; }
  .earlier summary { list-style: none; cursor: pointer; display: inline-flex; align-items: center; height: var(--chip-height); padding: 0 var(--space-4); border: var(--border-width) solid var(--glacier); border-radius: var(--radius-pill); background: var(--surface); color: var(--navy); font-size: var(--button-small-size); line-height: var(--button-small-line); font-weight: var(--button-small-weight); }
  .earlier summary::-webkit-details-marker { display: none; }
  .earlier .menu { position: absolute; top: calc(var(--chip-height) + 6px); left: 0; z-index: 3; display: flex; flex-direction: column; gap: var(--space-2); padding: var(--space-3); background: var(--surface); border: var(--border-width) solid var(--water-200); border-radius: var(--radius-sm); max-height: 60vh; overflow-y: auto; }
  .bar a[aria-current] { background: var(--glacier); color: #fff; }
  .year { padding: var(--space-8) 0; scroll-margin-top: 124px; }
  .year.alt { background: var(--water-50); }
  .note { margin: var(--space-2) 0 0; font-size: var(--caption-size); line-height: var(--caption-line); color: var(--ink-muted); }
  .grid { list-style: none; margin: var(--space-4) 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--grid-gutter); }
  @media (min-width: 768px) { .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } .year { padding: var(--space-12) 0; } }
  .tile { display: flex; flex-direction: column; gap: var(--space-2); text-decoration: none; color: var(--navy); }
  .tile img { display: block; width: 100%; aspect-ratio: 3 / 4; object-fit: cover; border-radius: var(--radius-sm); border: var(--border-width) solid var(--water-200); background: var(--water-50); }
  .cap { font-size: var(--body-small-size); line-height: var(--body-small-line); font-weight: var(--body-small-weight); }
</style>
