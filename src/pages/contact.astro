---
// Contact and support (D182), built from Contact.dc.html (canvas version 60). Indexable.
// Six topic buttons (aria-pressed) + name / mobile / WhatsApp fields + an optional question build ONE pre-filled WhatsApp message to the one number on record (D5).
// No form submission and no database (D22). The hero chat plays once in view, still with reduce-motion (D61, D110). Lazy images below the first screen.
// Claims (D179): no countdown, no punctuality promise, no reply-time promise (R-43, R-16). No testing-body names (D24). No monthly total (D91).
// "More answers in the FAQ" goes to the FAQ "coming soon" stub until the FAQ page exists (D182 c). "Directions" links open a map search for the address as recorded (D131, D132).
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import CallIcon from '../components/CallIcon.astro';
import { phoneDisplay, phoneTel, whatsappUrl } from '../data/site';
import shop from '../assets/home/shop.svg';
import rosette from '../assets/home/rosette.png';
const base = import.meta.env.BASE_URL;
const waGlyph = '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-12.6 7.3L3 20l1.3-5.2A8.4 8.4 0 1 1 21 11.5z"/><path d="M9 9.5c0 3 2.5 5.5 5.5 5.5l1.5-1.5-2-1-1 1a4 4 0 0 1-2.5-2.5l1-1-1-2z"/></svg>';
const chevron = '<svg class="go" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>';
const pin = '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#0a6f8f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex:0 0 auto"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>';
const shops = ['32/5 Block A, DHA Phase 1, Lahore', '358-E, Johar Town, Near Allah Hu Chowk, Lahore'];
const mapUrl = (a: string) => `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(a)}`;
const startMsg = 'Hi Glacial, I need help with: [pick a topic]\nName: [name]';
---
<Base fabLabel="Message" fabHref={`${whatsappUrl}?text=${encodeURIComponent(startMsg)}`} title="Contact and support — Glacial" description="Message Glacial on WhatsApp, call, or visit one of our two shops in Lahore. Quick answers on deposit, payment, booking and express delivery.">
  <section class="band navy hero">
    <div class="col">
      <div class="chat gl-mo" id="hero-chat">
        <svg width="300" height="200" viewBox="0 0 300 200" role="img" aria-label="A phone showing a WhatsApp chat: a customer sends a question and Glacial replies with a full water bottle and a tick">
          <circle cx="150" cy="104" r="92" fill="#14224b"/>
          <rect x="92" y="10" width="116" height="188" rx="18" fill="#ffffff"/>
          <rect x="100" y="26" width="100" height="164" rx="8" fill="#eef6fb"/>
          <rect x="132" y="16" width="36" height="5" rx="2.5" fill="#b9dcee"/>
          <rect x="100" y="26" width="100" height="22" rx="8" fill="#128c7e"/>
          <rect x="100" y="38" width="100" height="10" fill="#128c7e"/>
          <circle cx="112" cy="37" r="6" fill="#ffffff"/>
          <rect x="122" y="34" width="40" height="6" rx="3" fill="#ffffff" opacity="0.85"/>
          <g class="b1" style="transform-origin:180px 70px">
            <rect x="128" y="58" width="64" height="30" rx="8" fill="#d9ecf6"/>
            <rect x="136" y="66" width="46" height="5" rx="2.5" fill="#1a2a5b" opacity="0.55"/>
            <rect x="136" y="76" width="30" height="5" rx="2.5" fill="#1a2a5b" opacity="0.55"/>
          </g>
          <g class="dots">
            <rect x="108" y="98" width="38" height="20" rx="10" fill="#ffffff" stroke="#b9dcee"/>
            <circle cx="119" cy="108" r="3" fill="#5b6478"/><circle cx="127" cy="108" r="3" fill="#5b6478"/><circle cx="135" cy="108" r="3" fill="#5b6478"/>
          </g>
          <g class="b2" style="transform-origin:110px 140px">
            <rect x="108" y="124" width="74" height="54" rx="8" fill="#ffffff" stroke="#b9dcee"/>
            <g transform="translate(116 130) scale(0.75)">
              <rect x="13" y="1" width="10" height="6" rx="2" fill="#0a6f8f"/>
              <path d="M14 11h8c5 3 11 6 11 13v19q0 4-4 4H7q-4 0-4-4V24c0-7 6-10 11-13z" fill="#d9ecf6" stroke="#0a6f8f" stroke-width="2.5"/>
              <rect x="8" y="22" width="3" height="18" rx="1.5" fill="#ffffff"/>
            </g>
            <rect x="146" y="138" width="28" height="5" rx="2.5" fill="#1a2a5b" opacity="0.55"/>
            <rect x="146" y="148" width="20" height="5" rx="2.5" fill="#1a2a5b" opacity="0.55"/>
          </g>
          <g class="tick" style="transform-origin:196px 168px">
            <circle cx="196" cy="168" r="14" fill="#128c7e"/>
            <path d="M189 168.5l4.5 4.5 9-9" fill="none" stroke="#ffffff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
          </g>
        </svg>
      </div>
      <p class="eyebrow">CONTACT AND SUPPORT</p>
      <h1>Questions? Just message us.</h1>
      <p class="lede">Pick a topic. We write the WhatsApp message for you. It is the fastest way to reach us.</p>
      <a class="wa" href="#c-help"><Fragment set:html={waGlyph} />Message us on WhatsApp</a>
      <a class="call" href={`tel:${phoneTel}`}><CallIcon />Or call {phoneDisplay}</a>
    </div>
  </section>

  <section class="band pale" id="c-help">
    <div class="col">
      <h2>What can we help with?</h2>
      <p class="sub-ink">Tap one. Your message is ready to send.</p>
      <div class="topics" role="group" aria-label="Choose a topic">
        <button type="button" class="topic" data-topic="order" data-label="Order water" aria-pressed="false">
          <svg viewBox="0 0 40 40" aria-hidden="true"><circle class="bg" cx="20" cy="20" r="20" fill="#e6f3f7"/><g class="ic" fill="none" stroke="#0a6f8f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 8h6M18 8v3M22 8v3"/><path d="M17.5 11h5c3 2 5.5 4 5.5 8v11a2 2 0 0 1-2 2H14a2 2 0 0 1-2-2V19c0-4 2.5-6 5.5-8z"/><path d="M20 19v7M16.5 22.5h7"/></g></svg>
          <span class="t">Order water</span>
          <span class="s">New order or more bottles</span>
        </button>
        <button type="button" class="topic" data-topic="delivery" data-label="My delivery" aria-pressed="false">
          <svg viewBox="0 0 40 40" aria-hidden="true"><circle class="bg" cx="20" cy="20" r="20" fill="#e6f3f7"/><g class="ic" fill="none" stroke="#0a6f8f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 13h15v13H7z"/><path d="M22 17h6l4 4.5V26H22z"/><circle cx="12" cy="28" r="2.5"/><circle cx="27" cy="28" r="2.5"/></g></svg>
          <span class="t">My delivery</span>
          <span class="s">Where is it, or a new time</span>
        </button>
        <button type="button" class="topic" data-topic="sub" data-label="My subscription" aria-pressed="false">
          <svg viewBox="0 0 40 40" aria-hidden="true"><circle class="bg" cx="20" cy="20" r="20" fill="#e6f3f7"/><g class="ic" fill="none" stroke="#0a6f8f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="11" width="22" height="20" rx="3"/><path d="M9 17h22M15 8v5M25 8v5"/><path d="M16 25.5a4.5 4.5 0 0 0 8.2 1.5M24 22.5a4.5 4.5 0 0 0-8.2-1.5"/></g></svg>
          <span class="t">My subscription</span>
          <span class="s">Change bottles or my day</span>
        </button>
        <button type="button" class="topic" data-topic="bottle" data-label="Bottles and deposit" aria-pressed="false">
          <svg viewBox="0 0 40 40" aria-hidden="true"><circle class="bg" cx="20" cy="20" r="20" fill="#e6f3f7"/><g class="ic" fill="none" stroke="#0a6f8f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13.5 9h5M14 11.5h4c2.2 1.5 4 3 4 6v10.5a1.5 1.5 0 0 1-1.5 1.5h-9A1.5 1.5 0 0 1 10 28V17.5c0-3 1.8-4.5 4-6z"/><path d="M25 17h6l-2.5-2.5M31 23h-6l2.5 2.5"/></g></svg>
          <span class="t">Bottles and deposit</span>
          <span class="s">Return, exchange, deposit back</span>
        </button>
        <button type="button" class="topic" data-topic="pay" data-label="Paying" aria-pressed="false">
          <svg viewBox="0 0 40 40" aria-hidden="true"><circle class="bg" cx="20" cy="20" r="20" fill="#e6f3f7"/><g class="ic" fill="none" stroke="#0a6f8f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="8" y="13" width="24" height="15" rx="3"/><circle cx="20" cy="20.5" r="3.5"/><path d="M12 17.5v6M28 17.5v6"/></g></svg>
          <span class="t">Paying</span>
          <span class="s">Cash, shop counter, bank transfer</span>
        </button>
        <button type="button" class="topic" data-topic="other" data-label="Something else" aria-pressed="false">
          <svg viewBox="0 0 40 40" aria-hidden="true"><circle class="bg" cx="20" cy="20" r="20" fill="#e6f3f7"/><g class="ic" fill="none" stroke="#0a6f8f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M31 19.5a10 10 0 0 1-15 8.7L9 30l1.8-6.2A10 10 0 1 1 31 19.5z"/><path d="M17.5 17a3 3 0 1 1 3.5 3c-.7.2-1 .7-1 1.4v.6M20 25.5v0"/></g></svg>
          <span class="t">Something else</span>
          <span class="s">Ask us anything</span>
        </button>
      </div>

      <div class="fields">
        <div class="field"><label for="c-name">Name</label><input id="c-name" type="text" autocomplete="name" /></div>
        <div class="field"><label for="c-mobile">Mobile number <span>(we call you on this)</span></label><input id="c-mobile" type="tel" inputmode="tel" autocomplete="tel" placeholder="03XX-XXXXXXX" /></div>
        <div class="field"><label for="c-wa">WhatsApp number <span>(if different)</span></label><input id="c-wa" type="tel" inputmode="tel" placeholder="03XX-XXXXXXX" /></div>
        <div class="field"><label for="c-msg">Your question <span>(optional)</span></label><textarea id="c-msg" rows="3"></textarea></div>
      </div>

      <p class="preview-label">Your message</p>
      <div class="chatbox" aria-live="polite">
        <div class="bubble"><span id="c-preview"></span><span class="meta">ready to send <svg width="16" height="12" viewBox="0 0 16 12" fill="none" stroke="#0a6f8f" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 6.5l3 3L10 3.5M6 9.5l1 .5 7-7"/></svg></span></div>
      </div>
      <a class="wa" id="c-send" href={whatsappUrl}><Fragment set:html={waGlyph} />Send on WhatsApp</a>
      <p class="fine">WhatsApp opens with your message written. You check it, then tap send.</p>
      <a class="link" href={`${base}for-businesses/`}>Business customer? Your account manager helps you →</a>
    </div>
  </section>

  <section class="band white">
    <div class="col">
      <h2>Quick answers</h2>
      <ul class="qas">
        <li class="qa">
          <svg viewBox="0 0 56 56" aria-hidden="true"><circle cx="28" cy="28" r="28" fill="#e6f3f7"/><g fill="none" stroke="#0a6f8f" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M18 14h7M18.5 17.5h6c3 2 5.5 4 5.5 8.5v14a2 2 0 0 1-2 2H15a2 2 0 0 1-2-2V26c0-4.5 2.5-6.5 5.5-8.5z"/><path d="M44 30a8 8 0 1 1-2.3-5.6M42 20v5h-5"/></g></svg>
          <span class="t">Deposit back</span>
          <span class="s">Return the bottle. Your Rs 1,300 comes back.</span>
          <span class="m">Or exchange old for new: Rs 650, by its condition.</span>
        </li>
        <li class="qa">
          <svg viewBox="0 0 56 56" aria-hidden="true"><circle cx="28" cy="28" r="28" fill="#e6f3f7"/><g fill="none" stroke="#0a6f8f" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><rect x="12" y="18" width="32" height="21" rx="4"/><circle cx="28" cy="28.5" r="4.5"/><path d="M17 23v11M39 23v11"/></g></svg>
          <span class="t">How you pay</span>
          <span class="s">Cash when it arrives.</span>
          <span class="m">Or cash at the shop counter, or bank transfer.</span>
        </li>
        <li class="qa">
          <svg viewBox="0 0 56 56" aria-hidden="true"><circle cx="28" cy="28" r="28" fill="#e6f3f7"/><g fill="none" stroke="#0a6f8f" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="28" cy="28" r="14"/><path d="M28 20v8l5 3"/></g></svg>
          <span class="t">Book by 7pm</span>
          <span class="s">Delivery bookings until 7pm.</span>
          <span class="m">Shops open 9am–9pm, every day.</span>
        </li>
        <li class="qa">
          <svg viewBox="0 0 56 56" aria-hidden="true"><circle cx="28" cy="28" r="28" fill="#e6f3f7"/><g fill="none" stroke="#0a6f8f" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="37" r="4.5"/><circle cx="39" cy="37" r="4.5"/><path d="M18 37h7l6-12h5l3 12"/><path d="M25 25h6M8 22h8M10 28h6"/></g></svg>
          <span class="t">Ran out?</span>
          <span class="s">Express: at your door in 90 minutes or less<a class="star" href="#c-express-note" aria-label="See the note on delivery times">*</a></span>
          <span class="m">Order any time.</span>
        </li>
      </ul>
      <a class="link" href={`${base}faq/`}>More answers in the FAQ →</a>
      <p class="fine tight" id="c-express-note">* Delivery times vary by location. We confirm your time when you place the order.</p>
    </div>
  </section>

  <section class="band pale">
    <div class="col">
      <h2>Three ways to reach us</h2>
      <ul class="ways">
        <li><a class="way" href={whatsappUrl}>
          <span class="ico ico-wa"><Fragment set:html={waGlyph} /></span>
          <span><span class="t">WhatsApp</span><span class="s">{phoneDisplay} · fastest reply</span></span>
          <Fragment set:html={chevron} /></a></li>
        <li><a class="way" href={`tel:${phoneTel}`}>
          <span class="ico"><CallIcon /></span>
          <span><span class="t">Call</span><span class="s">{phoneDisplay}</span></span>
          <Fragment set:html={chevron} /></a></li>
        <li><a class="way" href="mailto:info@glacial.pk">
          <span class="ico"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3.5 6.5l8.5 6.5 8.5-6.5"/></svg></span>
          <span><span class="t">Email</span><span class="s">info@glacial.pk</span></span>
          <Fragment set:html={chevron} /></a></li>
      </ul>
    </div>
  </section>

  <section class="band white" id="c-shops">
    <div class="col">
      <h2>Rather talk face to face?</h2>
      <p class="sub-ink">Visit a Glacial Water Shop. Open 9am–9pm, every day.</p>
      <div class="crop">
        <img src={shop.src} alt="A Glacial Water Shop with the Glacial logo on its sign, a striped awning and bottles in the window" width="900" height="1109" loading="lazy" />
        <Image class="rosette" src={rosette} alt="Free refill offer: every 11th refill is free" width={84} loading="lazy" />
      </div>
      <ul class="shops">
        {shops.map((a) => (
          <li>
            <Fragment set:html={pin} />
            <span class="shop-txt"><span class="addr">{a}</span><a class="dir" href={mapUrl(a)} target="_blank" rel="noopener">Directions →</a></span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band navy contact">
    <div class="col">
      <h2>Certified &amp; pure. At your door, every week.</h2>
      <p class="sub">Send your order in one minute. We call you to confirm your delivery day and time.</p>
      <a class="order-now" href={`${base}order/`}>Order now</a>
      <a class="wa" href={whatsappUrl}><Fragment set:html={waGlyph} />Order on WhatsApp</a>
      <a class="call" href={`tel:${phoneTel}`}><CallIcon />Or call {phoneDisplay}</a>
    </div>
  </section>
</Base>

<script>
  import { armMotion } from '../lib/motion';
  armMotion();

  // One pre-filled WhatsApp message to the one number on record (D5): topic, name, mobile for the call-back, WhatsApp if different, then the question.
  const WA = 'https://wa.me/923111125124';
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const topics = Array.from(document.querySelectorAll<HTMLButtonElement>('.topic'));
  let topic = '';
  const val = (id: string) => ($(id) as HTMLInputElement).value.trim();
  function render() {
    const msg = 'Hi Glacial, I need help with: ' + (topic || '[pick a topic]') +
      '\nName: ' + (val('c-name') || '[name]') +
      (val('c-mobile') ? '\nMobile: ' + val('c-mobile') : '') +
      (val('c-wa') ? '\nWhatsApp: ' + val('c-wa') : '') +
      (val('c-msg') ? '\n\n' + val('c-msg') : '');
    const href = WA + '?text=' + encodeURIComponent(msg);
    $('c-preview').textContent = msg;
    ($('c-send') as HTMLAnchorElement).href = href;
    const fab = document.getElementById('fab') as HTMLAnchorElement | null;
    if (fab) fab.href = href;
  }
  topics.forEach((b) => b.addEventListener('click', () => {
    const on = b.getAttribute('aria-pressed') === 'true';
    topics.forEach((o) => o.setAttribute('aria-pressed', 'false'));
    topic = on ? '' : (b.dataset.label || '');
    if (!on) b.setAttribute('aria-pressed', 'true');
    render();
  }));
  ['c-name', 'c-mobile', 'c-wa', 'c-msg'].forEach((id) => $(id).addEventListener('input', render));
  render();
</script>

<style>
  .col { width: 100%; max-width: var(--grid-phone-max); margin: 0 auto; padding: 0 var(--space-5); }
  .band { padding: 32px 0; }
  .navy { background: var(--navy); color: var(--on-navy); }
  .pale { background: var(--water-50); }
  .white { background: var(--surface); }
  h2 { color: var(--navy); }
  .hero { padding: 26px 0 30px; }
  .chat { display: flex; justify-content: center; }
  .eyebrow { margin: 18px 0 0; font-size: 14px; line-height: 20px; font-weight: 700; letter-spacing: 0.08em; color: var(--water-200); }
  .hero h1 { margin: 6px 0 0; color: #fff; }
  .lede { margin: 12px 0 0; color: var(--water-200); }
  .wa { box-sizing: border-box; width: 100%; display: flex; align-items: center; justify-content: center; gap: 10px; min-height: 56px; margin-top: 20px; padding: 0 18px; border-radius: var(--radius-md); background: var(--whatsapp); color: var(--on-whatsapp); font-size: var(--button-whatsapp-size); line-height: var(--button-whatsapp-line); font-weight: var(--button-whatsapp-weight); text-decoration: none; }
  .wa:hover { background: var(--whatsapp-hover); color: var(--on-whatsapp); }
  .call { margin-top: 12px; display: flex; align-items: center; justify-content: center; gap: 10px; min-height: 52px; box-sizing: border-box; border: 1px solid #fff; border-radius: var(--radius-md); color: #fff; font-size: 17px; line-height: 24px; font-weight: 700; text-decoration: none; }
  .navy a:focus-visible { outline-color: var(--water-200); }
  .sub-ink { margin: 6px 0 0; color: var(--navy); }
  #c-help { scroll-margin-top: 70px; }
  .topics { margin-top: 16px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .topic { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; min-height: 112px; padding: 14px 14px 12px; box-sizing: border-box; background: #fff; border: 1px solid var(--water-200); border-radius: var(--radius-md); font-family: inherit; text-align: left; color: var(--navy); cursor: pointer; transition: background 0.15s ease, border-color 0.15s ease; }
  .topic svg { display: block; width: 40px; height: 40px; }
  .topic .t { font-size: 17px; line-height: 22px; font-weight: 700; }
  .topic .s { font-size: 14px; line-height: 19px; color: var(--ink-muted); }
  .topic[aria-pressed='true'] { background: var(--navy); border-color: var(--navy); color: #fff; }
  .topic[aria-pressed='true'] .s { color: var(--water-200); }
  .topic[aria-pressed='true'] svg :global(.ic) { stroke: #fff; }
  .topic[aria-pressed='true'] svg :global(.bg) { fill: var(--navy-hover); }
  .fields { margin-top: 20px; display: flex; flex-direction: column; gap: 12px; }
  .field { display: flex; flex-direction: column; gap: 6px; }
  .field label { font-size: 15px; line-height: 21px; font-weight: 600; color: var(--navy); }
  .field label span { font-weight: 400; color: var(--ink-muted); }
  .field input, .field textarea { min-height: 48px; box-sizing: border-box; padding: 0 14px; border: 1px solid var(--ink-muted); border-radius: var(--radius-sm); background: #fff; font-family: inherit; font-size: 17px; line-height: 24px; color: var(--navy); }
  .field textarea { padding: 12px 14px; min-height: 88px; resize: vertical; }
  .preview-label { margin: 18px 0 8px; font-size: 15px; line-height: 21px; font-weight: 600; color: var(--navy); }
  .chatbox { padding: 14px 12px 12px; box-sizing: border-box; background: var(--glacier-tint); border-radius: var(--radius-md); }
  .bubble { margin-left: auto; max-width: 290px; padding: 10px 12px 8px; box-sizing: border-box; background: #fff; border: 1px solid var(--water-200); border-radius: 14px 14px 4px 14px; font-size: 15px; line-height: 21px; color: var(--navy); white-space: pre-line; overflow-wrap: anywhere; }
  .meta { display: flex; justify-content: flex-end; align-items: center; gap: 4px; margin-top: 4px; font-size: 12px; line-height: 16px; color: var(--ink-muted); white-space: normal; }
  #c-send { margin-top: 14px; }
