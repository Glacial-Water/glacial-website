---
// How delivery works (D124), built from DeliveryB.dc.html (canvas version 32). Replaces the coming-soon stub.
// ONE change from the drawing (D124 d): the bookings bar shows no start time (D34 gives only "until 7pm"); the text line stays.
// How you pay (D127) and both shop addresses (D131 DHA, D132 Johar Town) are settled. Nothing invented.
// Motion: CSS/SVG only, plays once when 35% of the picture is in view; reduced motion or no script shows the finished picture, no layout shift.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import StepList from '../components/StepList.astro';
import { whatsappUrl, phoneDisplay, phoneTel } from '../data/site';
import truck from '../assets/home/truck.jpg';
import rider from '../assets/home/rider.jpg';
import rosette from '../assets/home/rosette.png';
import shop from '../assets/home/shop.svg';
import logo from '../assets/glacial-logo.png';
const base = import.meta.env.BASE_URL;
const u = (n: number) => `calc(${n} * var(--u))`;
const waGlyph = '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-12.6 7.3L3 20l1.3-5.2A8.4 8.4 0 1 1 21 11.5z"/><path d="M9 9.5c0 3 2.5 5.5 5.5 5.5l1.5-1.5-2-1-1 1a4 4 0 0 1-2.5-2.5l1-1-1-2z"/></svg>';
const waDelivery = 'https://wa.me/923111125124?text=' + encodeURIComponent('Hi Glacial, I have a question about delivery.');
const steps = [
  'Check your area|Type it in below. The answer shows right away.',
  'Send your order on WhatsApp|Your bottles and your address. About one minute.',
  'We confirm on WhatsApp|And tell you your delivery day and time.',
];
// Calendar: four weeks, one column marked. Thursday is only an example; the customer's day is confirmed on WhatsApp.
const dayNames = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
const mark = 3;
const cells = Array.from({ length: 28 }, (_, i) => ({ on: i % 7 === mark, delay: `${(0.2 + Math.floor(i / 7) * 0.25).toFixed(2)}s` }));
---
<Base fabHref={waDelivery} title="How delivery works — Glacial" description="How Glacial delivery works in Lahore: weekly subscription, express delivery in 90 minutes or less, delivery hours and our shops.">
  <section class="band navy">
    <div class="col">
      <h1>Same day. Same time.<br />Every week.</h1>
      <p class="lede">Certified, chlorine-free water at your door. You never have to call.</p>
      <div class="cal-card gl-mo" data-mo>
        <div role="img" aria-label="One month on a calendar. The same day is marked with a bottle in each of the four weeks.">
          <div class="cal head" aria-hidden="true">{dayNames.map((n, i) => <span class={`ch${i === mark ? ' on' : ''}`}>{n}</span>)}</div>
          <ul class="cal" aria-hidden="true">
            {cells.map((c) => (
              <li class={`cc${c.on ? ' on' : ''}`}>
                {c.on && <svg class="pop" width="18" height="24" viewBox="0 0 36 48" style={`--d:${c.delay}`}><rect x="13" y="1" width="10" height="6" rx="2" fill="#ffffff" /><rect x="14.5" y="6" width="7" height="6" fill="#d9ecf6" /><path d="M14 11h8c5 3 11 6 11 13v19q0 4-4 4H7q-4 0-4-4V24c0-7 6-10 11-13z" fill="#d9ecf6" /><rect x="8" y="22" width="3" height="20" rx="1.5" fill="#ffffff" opacity="0.7" /></svg>}
              </li>
            ))}
          </ul>
        </div>
        <p class="cal-key"><span class="sw" aria-hidden="true"></span>Your delivery day — the same every week</p>
      </div>
    </div>
  </section>

  <section class="white sec">
    <div class="col">
      <h2>Start in three steps</h2>
      <div class="stepwrap"><StepList items={steps} /></div>
      <a class="navy-btn" href={`${base}order/`}>Order now</a>
    </div>
  </section>

  <section class="pale sec">
    <div class="col">
      <h2>Full bottles in. Empties out.</h2>
      <p class="p">Every week we take your empty bottles and leave fresh, full ones.</p>
      <svg class="door" role="img" aria-label="At a front door: an empty bottle goes out, a full Glacial bottle comes in" viewBox="0 0 353 170" width="353" height="170">
        <rect x="0" y="0" width="353" height="170" rx="14" fill="#ffffff" />
        <rect x="146" y="22" width="62" height="132" rx="4" fill="#d9ecf6" stroke="#1a2a5b" stroke-width="2" />
        <rect x="155" y="32" width="44" height="46" rx="2" fill="none" stroke="#1a2a5b" stroke-width="1.5" opacity="0.5" />
        <rect x="155" y="88" width="44" height="56" rx="2" fill="none" stroke="#1a2a5b" stroke-width="1.5" opacity="0.5" />
        <circle cx="198" cy="94" r="3" fill="#1a2a5b" />
        <rect x="132" y="154" width="90" height="6" rx="2" fill="#1a2a5b" />
        <g transform="translate(42 56) scale(1.8)">
          <rect x="13" y="1" width="10" height="6" rx="2" fill="#9aa3b3" />
          <rect x="14.5" y="6" width="7" height="6" fill="#ffffff" stroke="#9cc0e2" stroke-width="1" />
          <path d="M14 11h8c5 3 11 6 11 13v19q0 4-4 4H7q-4 0-4-4V24c0-7 6-10 11-13z" fill="#ffffff" stroke="#9cc0e2" stroke-width="1.2" />
        </g>
        <path d="M136 40H22" fill="none" stroke="#5b6478" stroke-width="2.4" stroke-linecap="round" stroke-dasharray="2 6" />
        <path d="M30 33l-9 7 9 7" fill="none" stroke="#5b6478" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
        <text x="74" y="160" text-anchor="middle" font-family="Inter, sans-serif" font-size="14" font-weight="700" fill="#5b6478">Empty out</text>
        <g transform="translate(252 56) scale(1.8)">
          <rect x="13" y="1" width="10" height="6" rx="2" fill="#1a2a5b" />
          <rect x="14.5" y="6" width="7" height="6" fill="#9ccbe6" />
          <path d="M14 11h8c5 3 11 6 11 13v19q0 4-4 4H7q-4 0-4-4V24c0-7 6-10 11-13z" fill="#6fb6dc" />
          <rect x="3" y="27" width="30" height="3" fill="#ffffff" opacity="0.35" />
          <rect x="3" y="37" width="30" height="3" fill="#ffffff" opacity="0.35" />
          <rect x="8" y="22" width="3" height="20" rx="1.5" fill="#ffffff" opacity="0.4" />
        </g>
        <path d="M340 40h-96" fill="none" stroke="#0a6f8f" stroke-width="2.4" stroke-linecap="round" />
        <path d="M252 33l-9 7 9 7" fill="none" stroke="#0a6f8f" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
        <text x="284" y="160" text-anchor="middle" font-family="Inter, sans-serif" font-size="14" font-weight="700" fill="#0a6f8f">Full in</text>
      </svg>

      <article class="card" id="d-weekly">
        <span class="crop u351 walk-crop">
          <Image src={truck} alt="A Glacial delivery truck loaded with water bottles" widths={[351, 702]} sizes="(min-width: 430px) 430px, 100vw" loading="lazy" />
          <span class="slot" aria-hidden="true" style={`left:82%;top:${u(67)}`}><span class="u">Rs</span><span class="v">260</span></span>
        </span>
        <div class="card-body">
          <div class="name-row"><h3>Weekly subscription</h3><p class="price">Rs 260<span> /bottle</span></p></div>
          <p class="lead">Like clockwork. You never have to call.</p>
          <p class="sub">Same day, same time, every week. Two bottles or more.</p>
          <a class="go" href={`${base}order/`}>Start my subscription →</a>
        </div>
      </article>
    </div>
  </section>

  <section class="white sec">
    <div class="col">
      <h2>Ran out? We're on our way.</h2>
      <div class="ride-card gl-mo" data-mo role="img" aria-label="From the moment you order to your door: 90 minutes or less">
        <div class="track" aria-hidden="true">
          <div class="rail"></div>
          <div class="rail fill"></div>
          <div class="dot l"></div>
          <div class="dot r"></div>
          <svg class="ride" width="40" height="28" viewBox="0 0 40 28">
            <circle cx="8" cy="22" r="5" fill="none" stroke="#1a2a5b" stroke-width="2.4" />
            <circle cx="32" cy="22" r="5" fill="none" stroke="#1a2a5b" stroke-width="2.4" />
            <path d="M8 22h10l6-10h6l2 10" fill="none" stroke="#1a2a5b" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
            <rect x="2" y="6" width="12" height="11" rx="2" fill="#0a6f8f" />
            <path d="M26 12l-2-6h-4" fill="none" stroke="#1a2a5b" stroke-width="2.4" stroke-linecap="round" />
          </svg>
        </div>
        <div class="ride-labels" aria-hidden="true"><span>You order</span><span class="mid">90 minutes or less*</span><span>At your door</span></div>
      </div>

      <article class="card" id="d-express">
        <span class="crop u351 rider-crop">
          <Image src={rider} alt="A Glacial rider on a scooter with a bottle in the carrier box" widths={[351, 702]} sizes="(min-width: 430px) 430px, 100vw" loading="lazy" />
          <span class="slot" aria-hidden="true" style={`left:80.5%;top:${u(64)}`}><span class="u">Rs</span><span class="v">280</span></span>
        </span>
        <div class="card-body">
          <div class="name-row"><h3>Express delivery</h3><p class="price">Rs 280<span> /bottle</span></p></div>
          <p class="lead">Run out mid-week? A bottle at your door in 90 minutes.</p>
          <p class="sub">Order any time. At your door in 90 minutes or less<a class="star" href="#d-express-note" aria-label="See the note on delivery times">*</a></p>
          <a class="go" href={`${base}order/`}>Order express →</a>
        </div>
      </article>
    </div>
  </section>

  <section class="pale sec">
    <div class="col">
      <h2>Book by 7pm. Every day.</h2>
      <div class="hours" role="img" aria-label="Delivery bookings until 7pm. Shops open from 9am until 9pm, every day.">
        <div aria-hidden="true">
          <p class="hl">Delivery bookings</p>
          <div class="bar"><div class="barfill"></div></div>
          <p class="hl second">Shops open</p>
          <div class="bar shopbar"></div>
          <div class="ticks"><span class="t7">7pm</span><span class="t9">9pm</span></div>
        </div>
      </div>
      <p class="foot big">Delivery bookings until 7pm. Shops open 9am–9pm.</p>
    </div>
  </section>

  <section class="white sec" id="d-area">
    <div class="col">
      <h2>Do we deliver to you?</h2>
      <p class="p">We deliver across most of Lahore. Type your area to check.</p>
      <div class="fields">
        <div class="field"><label for="d-name">Name</label><input id="d-name" type="text" autocomplete="name" /></div>
        <div class="field"><label for="d-phone">Phone</label><input id="d-phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="03XX-XXXXXXX" /></div>
        <div class="field"><label for="d-area-in">Area</label><input id="d-area-in" type="text" autocomplete="address-level3" placeholder="For example, Johar Town" aria-describedby="d-area-answer" /></div>
        <div class="area-live" id="d-area-answer" role="status" aria-live="polite" aria-atomic="true"></div>
      </div>
      <p class="foot">We'll message you about delivery in your area.</p>
      <a class="wa" id="d-area-href" href={whatsappUrl}><Fragment set:html={waGlyph} />Check my area</a>
    </div>
  </section>

  <section class="pale sec know">
    <div class="col">
      <h2>Good to know</h2>
      <div class="list">
        <dl>
          <div class="row first"><dt>Weekly subscription</dt><dd>Two bottles or more</dd></div>
          <div class="row"><dt>Your first bottle</dt><dd>Rs 1,300 deposit,<br />you get it back</dd></div>
          <div class="row"><dt>Have Glacial bottles?</dt><dd>No deposit</dd></div>
          <div class="row"><dt>How you pay</dt><dd>Pay cash when your water arrives. You can also pay by bank transfer, or pay monthly.</dd></div>
        </dl>
      </div>
      <a class="go" href={`${base}prices/`}>All prices →</a>
      <p class="foot" id="d-express-note">* Delivery times vary by location. We confirm your time when you place the order.</p>
    </div>
  </section>

  <section class="white sec" id="d-shops">
    <div class="col">
      <h2>Rather collect? Walk in and save.</h2>
      <article class="card" id="d-walk">
        <span class="crop u351 walk-crop">
          <img src={shop.src} alt="A Glacial Water Shop with the Glacial logo on its sign, a striped awning and bottles in the window" width="900" height="1109" loading="lazy" />
          <span class="sign" aria-hidden="true" style={`left:${u(86)};top:${u(72)};width:${u(130)};height:${u(37)};`}><Image src={logo} alt="" widths={[80, 160]} sizes="60px" /><span>SHOP</span></span>
          <span class="slot" aria-hidden="true" style={`left:82%;top:${u(67)}`}><span class="u">Rs</span><span class="v">200</span></span>
          <Image src={rosette} alt="Free refill: buy 10, get 1 free" width={84} class="rosette" style={`left:${u(12)};top:${u(12)};width:${u(84)};height:${u(84)}`} loading="lazy" />
        </span>
        <div class="card-body">
          <div class="name-row"><h3>Walk-in refill</h3><p class="price">Rs 200<span> /refill</span></p></div>
          <p class="lead">Buy 10 refills, get 1 free.</p>
          <p class="sub">Bring your bottle to a Glacial shop. Open 9am–9pm, every day.</p>
          <a class="go" href="#d-shop-list">Our shops ↓</a>
        </div>
      </article>
      <ul class="shops" id="d-shop-list">
        {['32/5 Block A, DHA Phase 1, Lahore', '358-E, Johar Town, Near Allah Hu Chowk, Lahore'].map((s) => (
          <li>
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#0a6f8f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z" /><circle cx="12" cy="9.5" r="2.5" /></svg>
            <span class="shop-text"><span class="shop-name">{s}</span><span class="dir">Directions →</span></span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band navy contact">
    <div class="col">
      <h2>Start your subscription today!</h2>
      <p class="lede">Send your order in one minute. We confirm on WhatsApp.</p>
      <a class="order-now" href={`${base}order/`}>Order now</a>
      <a class="wa" href={waDelivery}><Fragment set:html={waGlyph} />Ask about delivery</a>
      <a class="call" href={`tel:${phoneTel}`}>Or call {phoneDisplay}</a>
    </div>
  </section>
</Base>

<script>
  import { lookupArea } from '../lib/areaMatch';
  const WA = 'https://wa.me/923111125124';
  const $ = (id: string) => document.getElementById(id) as HTMLElement;
  const val = (id: string) => ((document.getElementById(id) as HTMLInputElement | null)?.value || '').trim();
  // D106: the area check opens WhatsApp with "Area check: [area] — [name]" and the phone on the next line.
  function link() {
    const phone = val('d-phone');
    const msg = 'Area check: ' + (val('d-area-in') || '[area]') + ' — ' + (val('d-name') || '[name]') + (phone ? '\nPhone: ' + phone : '');
    ($('d-area-href') as HTMLAnchorElement).href = WA + '?text=' + encodeURIComponent(msg);
  }
  // D118: the answer shows as the visitor types; the list is read in the browser, nothing is sent anywhere (D22).
  const answer = $('d-area-answer');
  let timer: number | undefined;
  function check() {
    window.clearTimeout(timer);
    const typed = val('d-area-in').replace(/\s+/g, ' ');
    if (!typed) { answer.textContent = ''; return; }
    const hit = lookupArea(typed);
    const show = () => {
      const tick = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>';
      const chat = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0a6f8f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-12.6 7.3L3 20l1.3-5.2A8.4 8.4 0 1 1 21 11.5z"></path></svg>';
      answer.textContent = '';
      const p = document.createElement('p');
      p.className = 'area-answer ' + (hit ? 'yes' : 'no');
      p.innerHTML = hit ? tick : chat;
      const t = document.createElement('span');
      t.textContent = hit ? 'Yes — we deliver to ' + hit : 'Not in ' + typed + ' yet — message us and we’ll check';
      p.appendChild(t);
      answer.appendChild(p);
    };
    if (hit) show(); else timer = window.setTimeout(show, 600);
  }
  $('d-area-in').addEventListener('input', check);
  ['d-name', 'd-phone', 'd-area-in'].forEach((id) => $(id).addEventListener('input', link));
  // Motion plays once, when 35% of the picture is in view. Reduced motion or no IntersectionObserver: never armed, finished picture shows.
  const mo = Array.from(document.querySelectorAll<HTMLElement>('[data-mo]'));
  if (mo.length && 'IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const io = new IntersectionObserver((entries) => entries.forEach((en) => {
      if (en.isIntersecting) { en.target.classList.add('is-on'); io.unobserve(en.target); }
    }), { threshold: 0.35 });
    mo.forEach((el) => { el.classList.add('is-armed'); io.observe(el); });
  }
</script>

<style>
  .col { width: 100%; max-width: var(--grid-phone-max); margin: 0 auto; padding: 0 var(--space-5); }
  .band { padding: 26px 0 26px; }
  .navy { background: var(--navy); color: var(--on-navy); }
  .pale { background: var(--water-50); }
  .white { background: var(--surface); }
  .navy h1, .navy h2 { color: #fff; }
  .lede { margin: 10px 0 0; color: var(--water-200); }
  .navy :focus-visible { outline-color: var(--water-200); }
  .sec { padding: 28px 0; }
  .sec h2 { margin: 0; }
  .p { margin: 6px 0 0; }
  .foot { margin: 4px 0 0; font-size: var(--caption-size); line-height: var(--caption-line); color: var(--ink-muted); }
  .foot.big { margin-top: 12px; font-size: var(--body-small-size); line-height: var(--body-small-line); color: var(--navy); }
  /* hero calendar */
  .cal-card { margin-top: 20px; padding: 14px 14px 16px; box-sizing: border-box; background: #fff; border-radius: var(--radius-md); color: var(--navy); }
  .cal { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 6px; margin: 0; padding: 0; list-style: none; }
  .cal.head { margin-bottom: 8px; }
  .ch { font-size: 12px; line-height: 16px; font-weight: 600; color: var(--ink-muted); text-align: center; }
  .ch.on { color: var(--glacier); font-weight: 700; }
  .cc { height: 38px; border-radius: 8px; background: var(--water-50); display: flex; align-items: center; justify-content: center; }
  .cc.on { background: var(--glacier); }
  .cal-key { margin: 12px 0 0; display: flex; align-items: center; gap: 8px; font-size: var(--body-small-size); line-height: 21px; font-weight: 700; color: var(--navy); }
  .sw { flex: 0 0 auto; width: 14px; height: 14px; border-radius: 4px; background: var(--glacier); }
  /* steps */
  .stepwrap { margin-top: 16px; }
  .navy-btn { margin-top: 22px; display: flex; align-items: center; justify-content: center; min-height: 56px; box-sizing: border-box; border-radius: var(--radius-md); background: var(--navy); color: #fff; font-size: 19px; line-height: 26px; font-weight: 700; text-decoration: none; }
  .navy-btn:hover { background: var(--navy-hover); color: #fff; }
  .navy-btn:active { background: var(--navy-active); }
  /* door drawing */
  .door { display: block; margin-top: 16px; width: 100%; height: auto; }
  /* tiles (Products and prices' way cards, unchanged) */
  .crop { position: relative; display: block; overflow: hidden; line-height: 0; container-type: inline-size; background: transparent; }
  .crop :global(img) { display: block; width: 100%; height: auto; }
  .u351 { --u: calc(100cqw / 351); }
  .slot { position: absolute; transform: translate(-50%, -50%); display: flex; flex-direction: column; align-items: center; justify-content: center; color: #fff; text-align: center; line-height: normal; }
  .slot .u { font-size: 11px; line-height: 13px; font-weight: 600; letter-spacing: 0.04em; }
  .slot .v { font-size: 22px; line-height: 25px; font-weight: 700; }
  .card { margin-top: 16px; background: #fff; border: 2px solid var(--water-200); border-radius: var(--radius-md); overflow: hidden; scroll-margin-top: 70px; }
  .sec h2 + .card { margin-top: 14px; }
  .walk-crop { aspect-ratio: 351 / 268; }
  .walk-crop :global(img) { margin-top: calc(-125 * var(--u)); }
  .rider-crop { aspect-ratio: 351 / 280; }
  .rider-crop :global(img) { margin-top: calc(-118 * var(--u)); }
  .sign { position: absolute; display: flex; align-items: center; justify-content: center; gap: calc(5 * var(--u)); background: #fff; border-radius: calc(6 * var(--u)); color: var(--navy); font-size: calc(15 * var(--u)); line-height: calc(18 * var(--u)); font-weight: 700; letter-spacing: 0.06em; }
  .crop .sign :global(img) { width: auto; height: calc(19 * var(--u)); margin: 0; }
  .crop :global(.rosette) { position: absolute; margin: 0; max-width: none; }
  .card-body { padding: 14px var(--space-4) 12px; }
  .name-row { display: flex; align-items: center; gap: var(--space-3); }
  .name-row h3 { flex: 1 1 auto; margin: 0; font-size: 19px; line-height: 25px; font-weight: 700; }
  .price { margin: 0; font-size: 19px; line-height: 25px; font-weight: 700; white-space: nowrap; }
  .price span { font-size: 14px; font-weight: 500; color: var(--ink-muted); }
  .lead { margin: 6px 0 0; font-size: 17px; line-height: 24px; font-weight: 700; }
  .sub { margin: 4px 0 0; font-size: var(--body-small-size); line-height: var(--body-small-line); color: var(--ink-muted); }
  .go { display: inline-flex; align-items: center; min-height: var(--touch-min); margin-top: 4px; font-size: 17px; line-height: 24px; font-weight: 600; text-decoration: none; }
  .star { text-decoration: none; font-weight: 700; }
  /* ride */
  .ride-card { margin-top: 16px; padding: 16px 14px 14px; box-sizing: border-box; background: var(--water-50); border-radius: var(--radius-md); container-type: inline-size; }
  .track { position: relative; height: 40px; }
  .rail { position: absolute; left: 6px; right: 6px; top: 30px; height: 6px; border-radius: 3px; background: var(--water-100); }
