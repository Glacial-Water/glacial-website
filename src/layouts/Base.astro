---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/tokens.css';
import '../styles/base.css';
// Self-hosted fonts (D81 c): latin subset woff2, font-display swap, only the weights the system uses. No third-party request.
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/inter/latin-700.css';
import '@fontsource/quicksand/latin-500.css';
import { whatsappUrl, isProduction, localBusinessSchema } from '../data/site';
// fabHref: the page's main pre-filled WhatsApp message (D150); the plain chat when a page has none.
interface Props { title: string; description?: string; noindex?: boolean; fabHref?: string; fabLabel?: string }
const origin = (Astro.site?.origin ?? '');
const ld = JSON.stringify({ '@context': 'https://schema.org', '@graph': localBusinessSchema(origin) });
const canonical = isProduction && Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const { title, description = 'Glacial — pure water, delivered across Lahore.', noindex = false, fabHref = whatsappUrl, fabLabel = 'Order' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {(noindex || !isProduction) && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <script type="application/ld+json" set:html={ld} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main"><slot /></main>
    <SiteFooter />
    <!-- D150: floating WhatsApp button on every page. Fixed bottom-right; hidden while the page's own WhatsApp button, primary button or order summary is on screen. -->
    <a class="fab" id="fab" href={fabHref} aria-label={fabLabel === 'Order' ? 'Order on WhatsApp' : 'Message us on WhatsApp'}>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-12.6 7.3L3 20l1.3-5.2A8.4 8.4 0 1 1 21 11.5z"/><path d="M9 9.5c0 3 2.5 5.5 5.5 5.5l1.5-1.5-2-1-1 1a4 4 0 0 1-2.5-2.5l1-1-1-2z"/></svg>
      <span>{fabLabel}</span>
    </a>
    <script>
      // Watches every WhatsApp button (.wa), every [data-fab-hide] element (a page's primary button or order summary) and hides the floating button while any is on screen.
      const fab = document.getElementById('fab');
      if (fab && 'IntersectionObserver' in window) {
        const seen = new Set<Element>();
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => (e.isIntersecting ? seen.add(e.target) : seen.delete(e.target)));
          fab.classList.toggle('is-hidden', seen.size > 0);
        });
        document.querySelectorAll('.wa, [data-fab-hide]').forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
