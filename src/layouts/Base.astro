---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import OrderSheet from '../components/OrderSheet.astro';
import '../styles/tokens.css';
import '../styles/base.css';
// Self-hosted fonts (D81 c): latin subset woff2, font-display swap, only the weights the system uses. No third-party request.
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/inter/latin-700.css';
import '@fontsource/quicksand/latin-500.css';
interface Props { title: string; description?: string; noindex?: boolean }
const { title, description = 'Glacial — pure water, delivered across Lahore.', noindex = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main"><slot /></main>
    <SiteFooter />
    <OrderSheet />
  </body>
</html>
