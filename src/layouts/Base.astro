---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/tokens.css';
import '../styles/base.css';
// Self-hosted fonts (D81 c): latin subset woff2, font-display swap, only the weights the system uses. No third-party request.
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/inter/latin-700.css';
import '@fontsource/quicksand/latin-500.css';
import { whatsappUrl, phoneTel, isProduction, localBusinessSchema } from '../data/site';
// fabHref: the page's main pre-filled WhatsApp message (D150); the plain chat when a page has none.
interface Props { title: string; description?: string; noindex?: boolean; fabHref?: string; fabLabel?: string; canonicalPath?: string }  // fabLabel is kept so older pages still compile; the pair is icon-only (option 3)
const origin = (Astro.site?.origin ?? '');
const ld = JSON.stringify({ '@context': 'https://schema.org', '@graph': localBusinessSchema(origin) });
const canonical0 = Astro.props.canonicalPath;
const canonical = isProduction && Astro.site ? new URL(canonical0 ?? Astro.url.pathname, Astro.site).href : undefined;
const { title, description = 'Glacial — pure water, delivered across Lahore.', noindex = false, fabHref = whatsappUrl, fabLabel = 'Order' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {(noindex || !isProduction) && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <script type="application/ld+json" set:html={ld} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main"><slot /></main>
    <SiteFooter />
    <!-- D184 b / D189: floating buttons, option 3. Two round icon-only buttons side by side, bottom-right: call (navy, white handset), then WhatsApp outermost in its own green.
         Hidden while any page WhatsApp or call button, or a [data-fab-hide] element (primary button, Order's summary), is on screen (D150 b). -->
    <div class="fabs" id="fabs">
      <a class="fab-btn fab-call" href={`tel:${phoneTel}`} aria-label="Call Glacial">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 16.9v2.6a1.7 1.7 0 0 1-1.9 1.7 17 17 0 0 1-7.4-2.6 16.6 16.6 0 0 1-5.1-5.1A17 17 0 0 1 4 6.1 1.7 1.7 0 0 1 5.7 4.2h2.6a1.7 1.7 0 0 1 1.7 1.5c.1.8.3 1.6.6 2.4a1.7 1.7 0 0 1-.4 1.8l-1.1 1.1a13.6 13.6 0 0 0 5.1 5.1l1.1-1.1a1.7 1.7 0 0 1 1.8-.4c.8.3 1.6.5 2.4.6a1.7 1.7 0 0 1 1.5 1.7z"/></svg>
      </a>
      <a class="fab-btn fab-wa" id="fab" href={fabHref} aria-label="Order on WhatsApp">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-12.6 7.3L3 20l1.3-5.2A8.4 8.4 0 1 1 21 11.5z"/><path d="M9 9.5c0 3 2.5 5.5 5.5 5.5l1.5-1.5-2-1-1 1a4 4 0 0 1-2.5-2.5l1-1-1-2z"/></svg>
      </a>
    </div>
    <script>
      // Watches every WhatsApp button (.wa), every call link, and every [data-fab-hide] element, and hides the pair while any is on screen.
      const fabs = document.getElementById('fabs');
      if (fabs && 'IntersectionObserver' in window) {
        const seen = new Set<Element>();
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => (e.isIntersecting ? seen.add(e.target) : seen.delete(e.target)));
          fabs.classList.toggle('is-hidden', seen.size > 0);
        });
        document.querySelectorAll('.wa, [data-fab-hide], a[href^="tel:"]:not(.fab-btn)').forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
